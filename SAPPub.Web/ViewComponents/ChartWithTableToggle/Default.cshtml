@using SAPPub.Web.Helpers
@using SAPPub.Web.ViewComponents.ChartWithTableToggle
@model ChartWithTableToggleModel
@using SAPPub.Web.Constants;
@addTagHelper *, GovUk.Frontend.AspNetCore

@{
    var idPrefix = Model.IdPrefix;
    var chartIdPrefix = Model.ChartPrefix;
    var percentageSign = Model.IsPercentageData ? "%" : "";
    var chartMax = Model.IsPercentageData && !Model.IsScaled && Model.ShowFullPercentageAxis ? "100" : "";

    var showOverTime = !Model.HasEstablishmentData || DataViewToggleHelper.IsOverTimeView(Context.Request, idPrefix);
    var overTimeTableClass = Model.HasEstablishmentData ? "chart-table-toggle__table" : null;
}


<div id="@DataViewToggleHelper.AnchorId(idPrefix)"
     class="chart-table-toggle"
     data-id-prefix="@idPrefix"
     data-view="@(showOverTime ? DataViewToggleHelper.OverTimeView : DataViewToggleHelper.CurrentView)">
    @if (Model.HasEstablishmentData)
    {
        <div id="@(idPrefix)-current-year-data-container" data-view-panel="@DataViewToggleHelper.CurrentView" hidden="@showOverTime">
            <div class="govuk-button-group">
                <govuk-button id="@(idPrefix)-current-year-show-btn" type="button" class="govuk-button--secondary chart-table-toggle__table-btn">Show as a table</govuk-button>
            </div>

            <div class="govuk-button-group">
                <a id="@(idPrefix)-show-data-over-time-btn"
                   href="@DataViewToggleHelper.ViewUrl(Context.Request, idPrefix, overTime: true)"
                   role="button"
                   draggable="false"
                   class="govuk-button govuk-button--secondary"
                   data-module="govuk-button"
                   data-show-view="@DataViewToggleHelper.OverTimeView">Show data over time</a>
            </div>

            <div id="@(idPrefix)-current-year-chart-container" class="chart-container chart-table-toggle__chart">

                <p class="govuk-visually-hidden">@Constants.ScreenReaderUseTable</p>

                <canvas id="@(chartIdPrefix)-chart"
                        class="js-chart"
                        aria-labelledby="@(idPrefix)-current-year-table"
                        role="img"
                        data-type="bar"
                        data-scaled="@Model.IsScaled.ToString().ToLower()"
                        data-max='@chartMax'
                        data-chart='@Html.Raw(Json.Serialize(Model.CurrentData))'
                        data-colors='@Html.Raw(Json.Serialize(Constants.ChartColours))'>
                </canvas>
            </div>

            <div id="@(idPrefix)-current-year-table-container" class="chart-table-toggle__table">
                <table id="@(idPrefix)-current-year-table" class="govuk-table">
                    <tbody class="govuk-table__body">
                        @foreach (var label in Model.CurrentData.Labels.Select((value, i) => (value, i)))
                        {
                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header">@label.value</th>
                                <td class="govuk-table__cell">
                                    @(Model.CurrentData.Data[label.i].HasValue ? $"{Model.CurrentData.Data[label.i]}{percentageSign}" : Constants.NotAvailable)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }


    <div id="@(idPrefix)-data-over-time-data-container" data-view-panel="@DataViewToggleHelper.OverTimeView" hidden="@(!showOverTime)">
        @if (Model.HasEstablishmentData)
        {
            <div class="govuk-button-group">
                <govuk-button id="@(idPrefix)-data-over-time-show-btn" type="button" class="govuk-button--secondary chart-table-toggle__table-btn">Show as a table</govuk-button>
            </div>

            <div class="govuk-button-group">
                <a id="@(idPrefix)-show-current-data-btn"
                   href="@DataViewToggleHelper.ViewUrl(Context.Request, idPrefix, overTime: false)"
                   role="button"
                   draggable="false"
                   class="govuk-button govuk-button--secondary"
                   data-module="govuk-button"
                   data-show-view="@DataViewToggleHelper.CurrentView">Show current data</a>
            </div>

            <div id="@(idPrefix)-data-over-time-chart-container" class="chart-container chart-table-toggle__chart">

                <p class="govuk-body" id="@(idPrefix)-data-over-time-legend-explainer">@Constants.LegendExplainer</p>

                <div id="@(idPrefix)-data-overtime-chart-legend" class="chart-legend" data-chart-id="@(chartIdPrefix)-data-overtime-chart"></div>
                <div class="chart-container stacked">

                    <p class="govuk-visually-hidden">@Constants.ScreenReaderUseTable</p>

                    <canvas id="@(chartIdPrefix)-data-overtime-chart"
                            class="js-chart"
                            data-type="bar"
                            aria-labelledby="@(idPrefix)-data-overtime-table"
                            role="img"
                            data-show-legend="true"
                            data-scaled="@Model.IsScaled.ToString().ToLower()"
                            data-max='@chartMax'
                            data-chart='@Html.Raw(Json.Serialize(Model.OverTimeData))'
                            data-colors='@Html.Raw(Json.Serialize(Constants.ChartColours))'>
                    </canvas>
                </div>
            </div>
        }
        <div id="@(idPrefix)-data-over-time-table-container" class="@overTimeTableClass">
            <table id="@(idPrefix)-data-overtime-table" class="govuk-table">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header"></th>
                        @foreach (var label in Model.OverTimeData.Labels)
                        {
                            <th scope="col" class="govuk-table__header">@label</th>
                        }
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var dataset in Model.OverTimeData.Datasets.Select((value, i) => (value, i)))
                    {
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@dataset.value.Label</th>
                            @foreach (var data in dataset.value.Data)
                            {
                                <td class="govuk-table__cell">@(data.HasValue ? data + percentageSign : Constants.NotAvailable)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.ThreeYearAverageData is not null)
        {
            <h4 class="govuk-heading-s govuk-!-margin-top-6">@Model.ThreeYearAverageHeading</h4>
            <div class="govuk-body">@Model.ThreeYearAverageDescription</div>
            <div id="@(idPrefix)-three-year-average-chart-container" class="govuk-!-padding-bottom-9 chart-container chart-table-toggle__chart">

                <p class="govuk-visually-hidden">@Constants.ScreenReaderUseTable</p>

                <p class="govuk-body">@Constants.LegendExplainer</p>

                <canvas id="@(chartIdPrefix)-three-year-average-chart"
                        class="js-chart"
                        data-type="bar"
                        aria-labelledby="@(idPrefix)-three-year-average-table"
                        role="img"
                        data-scaled="@Model.IsScaled.ToString().ToLower()"
                        data-max='@chartMax'
                        data-chart='@Html.Raw(Json.Serialize(Model.ThreeYearAverageData))'
                        data-colors='@Html.Raw(Json.Serialize(Constants.ChartColours))'>
                </canvas>
            </div>

            <div id="@(idPrefix)-three-year-average-table-container" class="chart-table-toggle__table">
                <table id="@(idPrefix)-three-year-average-table" class="govuk-table">
                    <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">@Model.ThreeYearAverageHeading</caption>
                    <tbody class="govuk-table__body">
                        @foreach (var label in Model.ThreeYearAverageData.Labels.Select((value, i) => (value, i)))
                        {
                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header">@label.value</th>
                                <td class="govuk-table__cell">
                                    @(Model.ThreeYearAverageData.Data[label.i].HasValue ? $"{Model.ThreeYearAverageData.Data[label.i]}{percentageSign}" : Constants.NotAvailable)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
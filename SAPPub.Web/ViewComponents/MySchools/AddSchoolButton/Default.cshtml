@using SAPPub.Web.Models.MySchools
@model AddSchoolButtonViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, GovUk.Frontend.AspNetCore

@if (!Model.IsFeatureEnabled)
{
    return;
}

<form asp-controller="MySchoolsList"
      asp-action="ToggleSaveEstablishment"
      asp-area=""
      method="post"
      class="save-establishment-comparison-form"
      data-save-text="@Model.SaveText"
      data-saved-text="@Model.SavedText">

    <input type="hidden" name="urn" value="@Model.Urn" />
    <input type="hidden" name="isSearchPage" value="@Model.IsSearchPage.ToString()" />
    <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />

    @if (Model.IsSearchPage)
    {
        <govuk-button id="toggleSaveEstablishment" type="submit" class="govuk-heading-s @(Model.IsSaved ? "saved" : "")">
            <span>@(Model.IsSaved ? Model.SavedText : Model.SaveText)</span>
        </govuk-button>
    }
    else
    {
        @if (Model.IsListLimitReached && Model.IsSaved)
        {
            <govuk-button id="toggleSaveEstablishment" type="submit" class="govuk-heading-s saved">
                <span>@Model.SavedText</span>
            </govuk-button>
        }

        @if (!Model.IsListLimitReached)
        {
            <govuk-button id="toggleSaveEstablishment" type="submit" class="govuk-heading-s @(Model.IsSaved ? "saved" : "")">
                <span>@(Model.IsSaved ? Model.SavedText : Model.SaveText)</span>
            </govuk-button>
        }
    }
</form>
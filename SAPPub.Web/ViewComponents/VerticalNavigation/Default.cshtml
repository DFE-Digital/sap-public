@model SAPPub.Web.ViewComponents.VerticalNavigation.VerticalNavigationModel
@using SAPPub.Web.Constants
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Microsoft.FeatureManagement.AspNetCore
@using static SAPPub.Web.Constants.Constants;
@inject Microsoft.FeatureManagement.IFeatureManager FeatureManager

@if (Model != null)
{
    var routeAttributes = new Dictionary<string, string> { { RouteConstants.URN, Model.URN }, { RouteConstants.SchoolName, Model.SchoolNameClean } };

    <div class="govuk-grid-column-one-quarter">
        <nav class="moj-side-navigation" aria-label="Side navigation">
            <ul class="moj-side-navigation__list">
                <li class="moj-side-navigation__item  @(Model.ActivePage == RouteConstants.AboutTheSchool ? "moj-side-navigation__item--active" : "")">
                    <a asp-route="@RouteConstants.AboutTheSchool" asp-all-route-data="routeAttributes">
                        @if (Model.IsKS5)
                        {
                            <text>About the school or college</text>
                        }
                        else
                        {
                            <text>About the school</text>
                        }
                    </a>
                </li>

                @if (await FeatureManager.IsEnabledAsync(EnablePrimary) && Model.IsKS2 || Model.IsKS4)
                {
                    <li class="moj-side-navigation__item  @(Model.ActivePage == RouteConstants.AdmissionsRoot ? "moj-side-navigation__item--active" : "")">
                        <a asp-route="@RouteConstants.AdmissionsRoot" asp-all-route-data="routeAttributes">Admissions</a>
                    </li>
                }

                @if (await FeatureManager.IsEnabledAsync(EnablePrimary) && Model.IsKS2 || Model.IsKS4)
                {
                    <li class="moj-side-navigation__item  @(Model.ActivePage == RouteConstants.CurriculumRoot ? "moj-side-navigation__item--active" : "")">
                        <a asp-route="@RouteConstants.CurriculumRoot" asp-all-route-data="routeAttributes">Curriculum and extra-curricular activities</a>
                    </li>
                }

                @if (await FeatureManager.IsEnabledAsync(EnablePrimary) && Model.IsKS2 || Model.IsKS4)
                {
                    <li class="moj-side-navigation__item  @(Model.ActivePage == RouteConstants.Attendance ? "moj-side-navigation__item--active" : "")">
                        <a asp-route="@RouteConstants.Attendance" asp-all-route-data="routeAttributes">Attendance</a>
                    </li>
                }

                <feature name="EnablePrimary">
                    @if (Model.IsKS2)
                    {
                        <li class="moj-side-navigation__item  
                            @(new List<string> {
                                                RouteConstants.PrimaryAcademicPerformanceAttainmentAndProgress,
                                                RouteConstants.PrimaryAcademicPerformancePupilProgress,
                                                RouteConstants.PrimaryAcademicPerformanceAdditionalMeasures
                                            }.Contains(Model.ActivePage) ? " moj-side-navigation__item--active" : "") ">
                            <a asp-route="@RouteConstants.PrimaryAcademicPerformanceAttainmentAndProgress" asp-all-route-data="routeAttributes">Primary academic performance</a>
                        </li>
                    }
                </feature>
                @if (Model.IsKS4)
                {
                    <li class="moj-side-navigation__item  
                        @(new List<string> { 
                            RouteConstants.SecondaryAcademicPerformanceAttainmentAndProgress,
                            RouteConstants.SecondaryAcademicPerformanceEnglishAndMathsResults,
                            RouteConstants.SecondaryAcademicPerformanceSubjectsEntered,
                            RouteConstants.SecondaryAcademicPerformanceAdditionalMeasures
                        }.Contains(Model.ActivePage) ? " moj-side-navigation__item--active" : "") ">
                        <a asp-route="@RouteConstants.SecondaryAcademicPerformanceAttainmentAndProgress" asp-all-route-data="routeAttributes">Secondary academic performance</a>
                    </li>
                }
                <feature name="Enable16to19">
                    @if (Model.IsKS5)
                    {
                        <li class="moj-side-navigation__item  @(new List<string> { RouteConstants.KS5AcademicPerformanceLevel3, RouteConstants.KS5AcademicPerformanceLevel2, RouteConstants.KS5AcademicPerformanceEnglishMaths, RouteConstants.KS5AcademicPerformanceSubjectsEntered }.Contains(Model.ActivePage) ? " moj-side-navigation__item--active" : "") ">
                            <a asp-route="@RouteConstants.KS5AcademicPerformanceRoot" asp-all-route-data="routeAttributes">16 to 19 academic performance</a>
                        </li>
                    }
                </feature>
                @if (Model.IsKS4 || Model.IsKS5)
                {
                    <li class="moj-side-navigation__item   @(new List<string> { RouteConstants.DestinationsRoot, RouteConstants.SecondaryDestinations, RouteConstants.KS5Destinations, RouteConstants.KS5DestinationsHigher }.Contains(Model.ActivePage) ? "moj-side-navigation__item--active" : "")">
                        <a asp-route="@RouteConstants.DestinationsRoot" asp-all-route-data="routeAttributes">Destinations</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
}

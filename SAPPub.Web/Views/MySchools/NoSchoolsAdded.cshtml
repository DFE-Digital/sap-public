@using SAPPub.Web.Models.Banner
@using static SAPPub.Web.Constants.Constants;

@{
    ViewData["Title"] = "My schools list";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        @if (TempData.Get<BannerViewModel?>(BannerModel) is BannerViewModel bannerModel)
        {
            @await Component.InvokeAsync("Banner", bannerModel)
        }

        <h1 class="govuk-heading-l">
            <span class="govuk-caption-l">@ViewData["Title"]</span>
            Save schools to compare
        </h1>

        <p class="govuk-body">
            To save a secondary school, search for a school, click on its profile then select 'Save to my schools list'.
        </p>
        <p class="govuk-body">
            You can currently only save and compare secondary schools. You'll be able to save and compare primary schools and colleges in the future.
        </p>
        <a asp-route="@RouteConstants.Search" role="button" draggable="false" class="govuk-button govuk-!-margin-top-6 govuk-!-margin-bottom-6" data-module="govuk-button">Search for schools to compare</a>
    </div>
</div>

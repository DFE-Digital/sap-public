@model SAPPub.Web.Areas.Profiles.ViewModels.Overview.OverviewViewModel

@using SAPPub.Web.Constants
@using SAPPub.Web.Models.Banner
@using SAPPub.Web.Helpers
@using SAPPub.Web.ViewComponents.SchoolProfilePagination
@using SAPPub.Web.ViewComponents.VerticalNavigation
@using WebConstants = SAPPub.Web.Constants.Constants

@{
    ViewData["Header"] = "Overview";
    ViewData["Title"] = $"{Model.SchoolName} - {ViewData["Header"]}";
}

<div class="govuk-grid-row">

    @await Component.InvokeAsync(
        "VerticalNavigation",
        new VerticalNavigationModel
        {
            URN = Model.URN,
            SchoolName = Model.SchoolName,
            ActivePage = RouteConstants.Overview,
            IsKS2 = Model.IsKS2,
            IsKS4 = Model.IsKS4,
            IsKS5 = Model.IsKS5
        })

    <div class="govuk-grid-column-three-quarters">

        @if (TempData.Get<bool>(WebConstants.BannerAddSuccess))
        {
            var bodyContent =
                $"<div class=\"govuk-body\">" +
                $"<p>{Model.SchoolName}</p>" +
                $"<p>You can compare up to 6 schools at a time. " +
                $"<a class=\"govuk-link\" href=\"{Url.RouteUrl(RouteConstants.MySchoolsView)}\">" +
                $"View your schools list</a></p>" +
                $"</div>";

            @await Component.InvokeAsync(
                "Banner",
                new BannerViewModel
                {
                    Title = "Success",
                    HeaderContent = "School added to your schools list",
                    BodyContent = bodyContent,
                    IsRawHtml = true,
                    Id = $"establishment-comparison-{Model.URN}-add-success",
                    Role = "status",
                    Type = "Success"
                })
        }

        @if (TempData.Get<bool>(WebConstants.BannerRemoveSuccess))
        {
            @await Component.InvokeAsync(
                "Banner",
                new BannerViewModel
                {
                    Title = "Success",
                    HeaderContent = "School removed from your schools list",
                    BodyContent = $"<p class=\"govuk-body\">{Model.SchoolName}</p>",
                    IsRawHtml = true,
                    Id = $"establishment-comparison-{Model.URN}-remove-success",
                    Role = "status",
                    Type = "Success"
                })
        }

        <h2 class="govuk-heading-xl govuk-!-margin-bottom-4">
            Overview
        </h2>

        @*
            Map and address.
            The map container starts visually hidden so that with JavaScript
            disabled the map is not shown. map-schools.js reveals it when
            the map can be initialised.
        *@
        <div class="map-address govuk-!-margin-bottom-5">

            <div class="map-container govuk-visually-hidden">
                <div id="map"
                     data-radius-miles="3"
                     data-fixed-zoom="14"
                     data-lat="@Model.Latitude"
                     data-lon="@Model.Longitude"
                     data-name="@Model.SchoolName"
                     role="region"
                     aria-label="Map showing the location of @Model.SchoolName">

                    <div class="map-loading">
                        Loading Map…
                    </div>

                </div>
            </div>

            <div class="ataglance-address-row">

                <div class="ataglance-address-row__key">
                    Address
                </div>

                <div class="ataglance-address-row__value">
                    @Model.Address.DisplayText()
                </div>

            </div>

        </div>


        @* School information *@
        <div class="ataglance-card">

            <govuk-summary-list id="overview-school-information">

                <govuk-summary-list-row id="overview-phase">
                    <govuk-summary-list-row-key>
                        Phase of education
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @Model.EducationPhase.DisplayText()
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row id="overview-age-range">
                    <govuk-summary-list-row-key>
                        Age range
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @Model.AgeRange.DisplayText()
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row id="overview-pupil-count">
                    <govuk-summary-list-row-key>
                        Number of pupils
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @Model.NumberOfPupils.DisplayText()
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row id="overview-sen">
                    <govuk-summary-list-row-key>
                        Type of SEN provision
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @Model.SenTypes.DisplayText()
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row id="overview-phone">
                    <govuk-summary-list-row-key>
                        Phone
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>

                        @if (Model.Telephone.IsAvailable)
                        {
                            <a class="govuk-link govuk-link--no-visited-state"
                               href="tel:@Model.Telephone.Value">
                                @Model.Telephone.Value
                            </a>
                        }
                        else
                        {
                            @Model.Telephone.DisplayText()
                        }

                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row id="overview-website">
                    <govuk-summary-list-row-key>
                        Website
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>

                        @if (Model.SchoolWebsite.IsAvailable)
                        {
                            <a class="govuk-link govuk-link--no-visited-state"
                               href="@Model.SchoolWebsite.DisplayText(UrlHelper.EnsureHttpsUrl)"
                               target="_blank"
                               rel="noreferrer noopener">

                                View @Model.SchoolName's website

                                <span class="govuk-visually-hidden">
                                    (opens in a new tab)
                                </span>

                            </a>
                        }
                        else
                        {
                            @Model.SchoolWebsite.DisplayText()
                        }

                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row>
                    <govuk-summary-list-row-key>
                        Ofsted report
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>

                        <a class="govuk-link govuk-link--no-visited-state"
                           href="@Model.OfstedReportUrl"
                           target="_blank"
                           rel="noreferrer noopener">

                            View the latest Ofsted report

                            <span class="govuk-visually-hidden">
                                (opens in a new tab)
                            </span>

                        </a>

                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

            </govuk-summary-list>

            <div class="govuk-body govuk-!-margin-top-5">

                <a asp-route="@RouteConstants.AboutTheSchool"
                   asp-all-route-data="@Model.RouteAttributes"
                   class="ataglance-link__link govuk-!-font-weight-bold govuk-link govuk-link--no-visited-state">

                    <span class="ataglance-link__iconbox"
                          aria-hidden="true">

                        <svg class="ataglance-link__icon"
                             width="32"
                             height="32"
                             viewBox="0 0 32 32"
                             focusable="false"
                             aria-hidden="true">

                            <circle cx="16"
                                    cy="16"
                                    r="15"
                                    fill="currentColor" />

                            <path d="M9 15h10.2l-4.1-4.1 1.9-1.9 7.3 7-7.3 7-1.9-1.9 4.1-4.1H9z"
                                  fill="#ffffff" />

                        </svg>

                    </span>

                    <span class="ataglance-link__text">

                        @if (Model.IsExclusivelyKS5)
                        {
                            <text>
                                Find out more about the school or college, including policies on school uniform and SEN
                            </text>
                        }
                        else
                        {
                            <text>
                                Find out more about the school, including policies on school uniform and SEN
                            </text>
                        }

                    </span>

                </a>

            </div>

        </div>

        @* Primary school at a glance *@
    @if (Model.IsKS2)
    {
        <section aria-labelledby="primary-at-a-glance-heading"
                    class="govuk-!-margin-top-7">

            <h2 id="primary-at-a-glance-heading"
                class="govuk-heading-l">
                Primary school profile at a glance
            </h2>

            <div class="ataglance-accordion govuk-accordion"
                    data-module="govuk-accordion"
                    id="primary-at-a-glance-accordion">

                @* Pupil progress - closed by default *@
                <div class="govuk-accordion__section">

                    <div class="govuk-accordion__section-header">

                        <span id="primary-accordion-iconbox__progress"
                                class="ataglance-accordion-iconbox primary-ataglance-progress-iconbox"
                                aria-hidden="true">

                            <svg class="ataglance-accordion-iconbox__icon"
                                    viewBox="0 0 48 48"
                                    focusable="false"
                                    aria-hidden="true">

                                <circle cx="10"
                                        cy="15"
                                        r="4"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="4" />

                                <circle cx="38"
                                        cy="38"
                                        r="6"
                                        fill="currentColor" />

                                <path d="M14 15h10
                                            c4.5 0 7 2.5 7 6
                                            s-2.5 6-7 6h-5
                                            c-4.5 0-7 2.5-7 6
                                            s2.5 6 7 6h15"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="4"
                                        stroke-linecap="round"
                                        stroke-linejoin="round" />

                            </svg>

                        </span>

                        <h3 class="govuk-accordion__section-heading">
                            <span class="govuk-accordion__section-button"
                                    id="primary-accordion-progress-heading">
                                Pupil progress
                            </span>
                        </h3>

                    </div>

                    <div id="primary-at-a-glance-accordion-content-1"
                            class="govuk-accordion__section-content">

                        <div class="govuk-body">

                            <div class="ataglance-summary-card govuk-summary-card">

                                <div class="govuk-summary-card__title-wrapper">

                                    <h4 class="govuk-summary-card__title">
                                        How pupils performed between the end of key stage 1 and the end of key stage 2
                                    </h4>

                                </div>

                                <div class="govuk-summary-card__content">

                                    <p class="govuk-body">
                                        Pupil progress is measured between the end of key stage 1 and the end of key stage 2.
                                    </p>

                                    <p class="govuk-body">
                                        Progress scores are not available for the academic years 2024 to 2025 and 2025 to 2026 due to COVID-19 disruption.
                                    </p>

                                    <p class="govuk-body">
                                        You can view progress results from previous years on the school's full profile.
                                    </p>

                                    <div class="govuk-body">

                                        <a asp-route="@RouteConstants.PrimaryAcademicPerformancePupilProgress"
                                            asp-all-route-data="@Model.RouteAttributes"
                                            class="ataglance-link__link govuk-!-font-weight-bold govuk-link govuk-link--no-visited-state">

                                            <span class="ataglance-link__iconbox"
                                                    aria-hidden="true">

                                                <svg class="ataglance-link__icon"
                                                        viewBox="0 0 32 32"
                                                        focusable="false"
                                                        aria-hidden="true">

                                                    <circle cx="16"
                                                            cy="16"
                                                            r="14"
                                                            fill="currentColor" />

                                                    <path d="M9 15h9.5l-3.5-3.5 1.8-1.8L23 16l-6.2 6.3-1.8-1.8 3.5-3.5H9z"
                                                            fill="#ffffff" />

                                                </svg>

                                            </span>

                                            <span class="ataglance-link__text">
                                                Find out more about the progress pupils make at this school for previous years
                                            </span>

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                @* Meeting expected standard - open by default *@
                <div class="govuk-accordion__section govuk-accordion__section--expanded">

                    <div class="govuk-accordion__section-header">

                        <span id="primary-accordion-iconbox__expected-standard"
                              class="ataglance-accordion-iconbox primary-ataglance-expected-standard-iconbox"
                              aria-hidden="true">

                            <svg class="ataglance-accordion-iconbox__icon"
                                 viewBox="0 0 48 48"
                                 focusable="false"
                                 aria-hidden="true">

                                <path d="M10 25l9 9 20-22"
                                      fill="none"
                                      stroke="currentColor"
                                      stroke-width="5"
                                      stroke-linecap="square"
                                      stroke-linejoin="miter" />

                            </svg>

                        </span>

                        <h3 class="govuk-accordion__section-heading">
                            <span class="govuk-accordion__section-button"
                                  id="primary-accordion-expected-standard-heading">
                                Meeting expected standard in reading, writing and maths
                            </span>
                        </h3>

                    </div>

                    <div id="primary-at-a-glance-accordion-content-2"
                         class="govuk-accordion__section-content">

                        <div class="govuk-body">

                            <div class="ataglance-summary-card govuk-summary-card">

                                <div class="govuk-summary-card__title-wrapper">

                                    <h4 class="govuk-summary-card__title">
                                        Percentage of pupils meeting expected standard for reading, writing and maths at the end of KS2
                                    </h4>

                                </div>

                                <div class="govuk-summary-card__content">

                                    <p class="govuk-body">
                                        This data is for the 2024 to 2025 academic year.
                                    </p>

                                    <div id="overview-primary-expected-standard-current-year-data-container"
                                         class="overview-chart-table">

                                        <div class="govuk-button-group">

                                            <govuk-button id="overview-primary-expected-standard-current-year-show-btn"
                                                          type="button"
                                                          class="govuk-button--secondary overview-chart-table__toggle govuk-!-display-none">
                                                Show as a table
                                            </govuk-button>

                                        </div>

                                        <div id="overview-primary-expected-standard-current-year-chart-container"
                                             class="chart-container ataglance-results-chart overview-chart-table__chart govuk-!-display-none">

                                            <canvas id="overview-primary-expected-standard-chart"
                                                    class="js-chart"
                                                    data-type="bar"
                                                    data-not-available-text="@WebConstants.NotAvailable"
                                                    data-chart='@Html.Raw(Json.Serialize(Model.ReadingWritingMathsExpectedChart))'
                                                    data-colors='@Html.Raw(Json.Serialize(WebConstants.ChartColours))'>
                                            </canvas>

                                        </div>

                                        <div id="overview-primary-expected-standard-current-year-table-container"
                                             class="overview-chart-table__table">

                                            <table id="overview-primary-expected-standard-current-year-table"
                                                   class="govuk-table">

                                                <thead class="govuk-table__head">
                                                    <tr class="govuk-table__row">
                                                        <th scope="col"
                                                            class="govuk-table__header">
                                                            Comparison
                                                        </th>

                                                        <th scope="col"
                                                            class="govuk-table__header govuk-table__header--numeric">
                                                            Percentage
                                                        </th>
                                                    </tr>
                                                </thead>

                                                <tbody class="govuk-table__body">

                                                    @foreach (var item in Model.ReadingWritingMathsExpectedChart.Labels.Select(
                                                        (value, index) => (value, index)))
                                                    {
                                                        <tr class="govuk-table__row">

                                                            <th scope="row"
                                                                class="govuk-table__header">
                                                                @item.value
                                                            </th>

                                                            <td class="govuk-table__cell govuk-table__cell--numeric">
                                                                @(Model.ReadingWritingMathsExpectedChart.Data[item.index].HasValue
                                                                    ? $"{Model.ReadingWritingMathsExpectedChart.Data[item.index]}%"
                                                                    : WebConstants.NotAvailable)
                                                            </td>

                                                        </tr>
                                                    }

                                                </tbody>

                                            </table>

                                        </div>

                                    </div>

                                    <div class="govuk-body">

                                        <a asp-route="@RouteConstants.PrimaryAcademicPerformanceMeetingOrExceedingStandards"
                                           asp-all-route-data="@Model.RouteAttributes"
                                           class="ataglance-link__link govuk-!-font-weight-bold govuk-link govuk-link--no-visited-state">

                                            <span class="ataglance-link__iconbox"
                                                  aria-hidden="true">

                                                <svg class="ataglance-link__icon"
                                                     viewBox="0 0 32 32"
                                                     focusable="false"
                                                     aria-hidden="true">

                                                    <circle cx="16"
                                                            cy="16"
                                                            r="14"
                                                            fill="currentColor" />

                                                    <path d="M9 15h9.5l-3.5-3.5 1.8-1.8L23 16l-6.2 6.3-1.8-1.8 3.5-3.5H9z"
                                                          fill="#ffffff" />

                                                </svg>

                                            </span>

                                            <span class="ataglance-link__text">
                                                Find out more about what pupils achieved at this school
                                            </span>

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            </div>

        </section>
    }

        @* Secondary school at a glance *@
        @if (Model.IsKS4)
        {
            <section aria-labelledby="secondary-at-a-glance-heading"
                     class="govuk-!-margin-top-7">

                <h2 id="secondary-at-a-glance-heading"
                    class="govuk-heading-l">
                    Secondary school profile at a glance
                </h2>

                <div class="ataglance-accordion govuk-accordion"
                     data-module="govuk-accordion"
                     id="secondary-at-a-glance-accordion">


                    @* Pupil progress *@
                    <div class="govuk-accordion__section">

                        <div class="govuk-accordion__section-header">

                            <span id="accordion-iconbox__progress"
                                  class="ataglance-accordion-iconbox"
                                  aria-hidden="true">

                                <svg class="ataglance-accordion-iconbox__icon"
                                     viewBox="0 0 48 48"
                                     focusable="false"
                                     aria-hidden="true">

                                    <circle cx="10"
                                            cy="15"
                                            r="4"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="4" />

                                    <circle cx="38"
                                            cy="38"
                                            r="6"
                                            fill="currentColor" />

                                    <path d="M14 15h10
                                             c4.5 0 7 2.5 7 6
                                             s-2.5 6-7 6h-5
                                             c-4.5 0-7 2.5-7 6
                                             s2.5 6 7 6h15"
                                          fill="none"
                                          stroke="currentColor"
                                          stroke-width="4"
                                          stroke-linecap="round"
                                          stroke-linejoin="round" />

                                </svg>

                            </span>

                            <h3 class="govuk-accordion__section-heading">
                                <span class="govuk-accordion__section-button"
                                      id="accordion-progress-heading">
                                    Pupil progress
                                </span>
                            </h3>

                        </div>

                        <div id="secondary-at-a-glance-accordion-content-1"
                             class="govuk-accordion__section-content">

                            <div class="govuk-body">

                                <div class="ataglance-summary-card govuk-summary-card">

                                    <div class="govuk-summary-card__title-wrapper">

                                        <h4 class="govuk-summary-card__title">
                                            How pupils performed between the end of primary school and the end of key stage 4 (year 11)
                                        </h4>

                                    </div>

                                    <div class="govuk-summary-card__content">

                                        <p class="govuk-body">
                                            Progress scores are not available for the academic years 2024 to 2025 and 2025 to 2026 due to COVID-19 disruption.
                                        </p>

                                        <p class="govuk-body">
                                            You can view progress results from previous years on the school's full profile.
                                        </p>

                                        <div class="govuk-body">

                                            <a asp-route="@RouteConstants.SecondaryAcademicPerformanceAttainmentAndProgress"
                                               asp-all-route-data="@Model.RouteAttributes"
                                               class="ataglance-link__link govuk-!-font-weight-bold govuk-link govuk-link--no-visited-state">

                                                <span class="ataglance-link__iconbox"
                                                      aria-hidden="true">

                                                    <svg class="ataglance-link__icon"
                                                         viewBox="0 0 32 32"
                                                         focusable="false"
                                                         aria-hidden="true">

                                                        <circle cx="16"
                                                                cy="16"
                                                                r="14"
                                                                fill="currentColor" />

                                                        <path d="M9 15h9.5l-3.5-3.5 1.8-1.8L23 16l-6.2 6.3-1.8-1.8 3.5-3.5H9z"
                                                              fill="#ffffff" />

                                                    </svg>

                                                </span>

                                                <span class="ataglance-link__text">
                                                    Find out more about the progress pupils make at this school for previous years
                                                </span>

                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    @* Average pupil achievement - open by default *@
                    <div class="govuk-accordion__section govuk-accordion__section--expanded">

                        <div class="govuk-accordion__section-header">

                            <span id="accordion-iconbox__attainment"
                                  class="ataglance-accordion-iconbox"
                                  aria-hidden="true">

                                <img src="~/assets/images/assignment-icon.svg"
                                     class="ataglance-accordion-iconbox__icon"
                                     alt="" />

                            </span>

                            <h3 class="govuk-accordion__section-heading">
                                <span class="govuk-accordion__section-button"
                                      id="accordion-attainment-heading">
                                    Average pupil achievement
                                </span>
                            </h3>

                        </div>

                        <div id="secondary-at-a-glance-accordion-content-2"
                             class="govuk-accordion__section-content">

                            <div class="govuk-body">

                                <div class="ataglance-summary-card govuk-summary-card">

                                    <div class="govuk-summary-card__title-wrapper">

                                        <h4 class="govuk-summary-card__title">
                                            Average results across 8 GCSE-level qualifications
                                        </h4>

                                    </div>

                                    <div class="govuk-summary-card__content">

                                        <p class="govuk-body">
                                            Attainment 8 is used to assess a pupil's average achievement across 8 GCSEs and equivalent subjects.
                                        </p>

                                        <p class="govuk-body">
                                            The qualifications included in this average result may include GCSEs and approved technical and vocational qualifications.
                                        </p>

                                        <p class="govuk-body">
                                            This data is for the 2024 to 2025 academic year.
                                        </p>


                                        @* Establishment result *@
                                        <dl class="govuk-summary-list govuk-!-margin-bottom-5">

                                            <div class="govuk-summary-list__row">

                                                <dt class="govuk-summary-list__key">
                                                    Average result
                                                </dt>

                                                <dd class="govuk-summary-list__value">
                                                    @Model.Attainment8.DisplayNumber(format: "N1")
                                                </dd>

                                            </div>

                                        </dl>


                                        @* Explanation of establishment result *@
                                        @if (Model.Attainment8.IsAvailable &&
                                             Model.Attainment8.Value.Value.HasValue &&
                                             Model.Attainment8Context.IsAvailable)
                                        {
                                            <div class="ataglance-card govuk-!-margin-bottom-5">

                                                <h5 class="ataglance-card__heading govuk-heading-s">
                                                    What does this mean?
                                                </h5>

                                                <p class="govuk-body govuk-!-margin-bottom-0">
                                                    This means that pupils generally scored the equivalent of
                                                    @Model.Attainment8Context.DisplayText()
                                                    in their 8 subjects.
                                                </p>

                                            </div>
                                        }


                                        @* Local authority and England comparison results *@
                                        
                                            <dl class="govuk-summary-list govuk-!-margin-bottom-5">

                                            <div class="govuk-summary-list__row">

                                                <dt class="govuk-summary-list__key">
                                                    @Model.LocalAuthorityName average
                                                </dt>

                                                <dd class="govuk-summary-list__value">
                                                    @Model.Attainment8LA.DisplayNumber(format:"N1")
                                                </dd>

                                            </div>

                                            <div class="govuk-summary-list__row">

                                                <dt class="govuk-summary-list__key">
                                                    England average
                                                </dt>

                                                <dd class="govuk-summary-list__value">

                                                    @if (Model.Attainment8England.IsAvailable &&
                                                         Model.Attainment8England.Value.Value is double attainment8England)
                                                    {
                                                        @attainment8England.ToString("0.0")
                                                    }
                                                    else
                                                    {
                                                        <text>Not available</text>
                                                    }

                                                </dd>

                                            </div>

                                        </dl>


                                        @* Link to full Progress and attainment page *@
                                        <div class="govuk-body">

                                            <a asp-route="@RouteConstants.SecondaryAcademicPerformanceAttainmentAndProgress"
                                               asp-all-route-data="@Model.RouteAttributes"
                                               class="ataglance-link__link govuk-!-font-weight-bold govuk-link govuk-link--no-visited-state">

                                                <span class="ataglance-link__iconbox"
                                                      aria-hidden="true">

                                                    <svg class="ataglance-link__icon"
                                                         viewBox="0 0 32 32"
                                                         focusable="false"
                                                         aria-hidden="true">

                                                        <circle cx="16"
                                                                cy="16"
                                                                r="14"
                                                                fill="currentColor" />

                                                        <path d="M9 15h9.5l-3.5-3.5 1.8-1.8L23 16l-6.2 6.3-1.8-1.8 3.5-3.5H9z"
                                                              fill="#ffffff" />

                                                    </svg>

                                                </span>

                                                <span class="ataglance-link__text">
                                                    Find out more about pupil achievement at this school
                                                </span>

                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    @* English and maths GCSE results - closed by default *@
                    <div class="govuk-accordion__section">

                        <div class="govuk-accordion__section-header">

                            <span id="accordion-iconbox__english-maths"
                                  class="ataglance-accordion-iconbox"
                                  aria-hidden="true">

                                <img src="~/assets/images/at-a-glance-bar-chart-icon.svg"
                                     class="ataglance-accordion-iconbox__icon"
                                     alt="" />

                            </span>

                            <h3 class="govuk-accordion__section-heading">
                                <span class="govuk-accordion__section-button"
                                      id="accordion-english-maths-heading">
                                    English and maths GCSE results
                                </span>
                            </h3>

                        </div>

                        <div id="secondary-at-a-glance-accordion-content-3"
                             class="govuk-accordion__section-content">

                            <div class="govuk-body">

                                <div class="ataglance-summary-card govuk-summary-card">

                                    <div class="govuk-summary-card__title-wrapper">

                                        <h4 class="govuk-summary-card__title">
                                            Percentage of pupils achieving grade 5 and above in English and maths GCSEs
                                        </h4>

                                    </div>

                                    <div class="govuk-summary-card__content">

                                        <p class="govuk-body">
                                            Grade 5 is comparable to the top of the old grade C.
                                        </p>

                                        <p class="govuk-body">
                                            This data is for the 2024 to 2025 academic year.
                                        </p>

                                        <div id="overview-english-maths-current-year-data-container"
                                             class="overview-chart-table">

                                            <div class="govuk-button-group">
                                                <govuk-button id="overview-english-maths-current-year-show-btn"
                                                              type="button"
                                                              class="govuk-button--secondary overview-chart-table__toggle govuk-!-display-none">
                                                    Show as a table
                                                </govuk-button>
                                            </div>

                                            <div id="overview-english-maths-current-year-chart-container"
                                                 class="chart-container ataglance-results-chart overview-chart-table__chart govuk-!-display-none">

                                                <canvas id="overview-english-maths-chart"
                                                        class="js-chart"
                                                        data-type="bar"
                                                        data-not-available-text="@WebConstants.NotAvailable"
                                                        data-chart='@Html.Raw(Json.Serialize(Model.EnglishAndMathsGrade5Chart))'
                                                        data-colors='@Html.Raw(Json.Serialize(WebConstants.ChartColours))'>
                                                </canvas>
                                            </div>

                                            <div id="overview-english-maths-current-year-table-container"
                                                 class="overview-chart-table__table">

                                                <table id="overview-english-maths-current-year-table"
                                                       class="govuk-table">
                                                    <tbody class="govuk-table__body">
                                                        @foreach (var label in Model.EnglishAndMathsGrade5Chart.Labels.Select((value, i) => (value, i)))
                                                        {
                                                            <tr class="govuk-table__row">
                                                                <th scope="row" class="govuk-table__header">
                                                                    @label.value
                                                                </th>
                                                                <td class="govuk-table__cell">
                                                                    @(Model.EnglishAndMathsGrade5Chart.Data[label.i].HasValue
                                                                        ? $"{Model.EnglishAndMathsGrade5Chart.Data[label.i]}%"
                                                                        : WebConstants.NotAvailable)
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>

                                            </div>
                                        </div>
                                        <div class="govuk-body">

                                            <a asp-route="@RouteConstants.SecondaryAcademicPerformanceEnglishAndMathsResults"
                                               asp-all-route-data="@Model.RouteAttributes"
                                               class="ataglance-link__link govuk-!-font-weight-bold govuk-link govuk-link--no-visited-state">

                                                <span class="ataglance-link__iconbox"
                                                      aria-hidden="true">

                                                    <svg class="ataglance-link__icon"
                                                         viewBox="0 0 32 32"
                                                         focusable="false"
                                                         aria-hidden="true">

                                                        <circle cx="16"
                                                                cy="16"
                                                                r="14"
                                                                fill="currentColor" />

                                                        <path d="M9 15h9.5l-3.5-3.5 1.8-1.8L23 16l-6.2 6.3-1.8-1.8 3.5-3.5H9z"
                                                              fill="#ffffff" />

                                                    </svg>

                                                </span>

                                                <span class="ataglance-link__text">
                                                    Find out more about English and maths results at this school
                                                </span>

                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    @* What pupils did after year 11 - closed by default *@
                    <div class="govuk-accordion__section">

                        <div class="govuk-accordion__section-header">

                            <span id="accordion-iconbox__destinations"
                                  class="ataglance-accordion-iconbox"
                                  aria-hidden="true">

                                <img src="~/assets/images/at-a-glance-destinations-icon.svg"
                                     class="ataglance-accordion-iconbox__icon"
                                     alt="" />

                            </span>

                            <h3 class="govuk-accordion__section-heading">
                                <span class="govuk-accordion__section-button"
                                      id="accordion-destinations-heading">
                                    What pupils did after year 11
                                </span>
                            </h3>

                        </div>

                        <div id="secondary-at-a-glance-accordion-content-4"
                             class="govuk-accordion__section-content">

                            <div class="govuk-body">

                                <div class="ataglance-summary-card govuk-summary-card">

                                    <div class="govuk-summary-card__title-wrapper">

                                        <h4 class="govuk-summary-card__title">
                                            Percentage of pupils who either stayed in education, went into an apprenticeship or entered employment for at least 6 months after finishing year 11 (key stage 4)
                                        </h4>

                                    </div>

                                    <div class="govuk-summary-card__content">

                                        <p class="govuk-body">
                                            This data is for pupils who finished year 11 in the 2022 to 2023 academic year.
                                        </p>

                                        <div id="overview-destinations-current-year-data-container"
                                             class="overview-chart-table">

                                            <div class="govuk-button-group">
                                                <govuk-button id="overview-destinations-current-year-show-btn"
                                                              type="button"
                                                              class="govuk-button--secondary overview-chart-table__toggle govuk-!-display-none">
                                                    Show as a table
                                                </govuk-button>
                                            </div>

                                            <div id="overview-destinations-current-year-chart-container"
                                                 class="chart-container ataglance-results-chart overview-chart-table__chart govuk-!-display-none">

                                                <canvas id="overview-destinations-chart"
                                                        class="js-chart"
                                                        data-type="bar"
                                                        data-not-available-text="@WebConstants.NotAvailable"
                                                        data-chart='@Html.Raw(Json.Serialize(Model.DestinationsChart))'
                                                        data-colors='@Html.Raw(Json.Serialize(WebConstants.ChartColours))'>
                                                </canvas>
                                            </div>

                                            <div id="overview-destinations-current-year-table-container"
                                                 class="overview-chart-table__table">

                                                <table id="overview-destinations-current-year-table"
                                                       class="govuk-table">
                                                    <tbody class="govuk-table__body">
                                                        @foreach (var label in Model.DestinationsChart.Labels.Select((value, i) => (value, i)))
                                                        {
                                                            <tr class="govuk-table__row">
                                                                <th scope="row" class="govuk-table__header">
                                                                    @label.value
                                                                </th>
                                                                <td class="govuk-table__cell">
                                                                    @(Model.DestinationsChart.Data[label.i].HasValue
                                                                        ? $"{Model.DestinationsChart.Data[label.i]}%"
                                                                        : WebConstants.NotAvailable)
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>

                                            </div>
                                        </div>
                                        <div class="govuk-body">

                                            <a asp-route="@RouteConstants.SecondaryDestinations"
                                               asp-all-route-data="@Model.RouteAttributes"
                                               class="ataglance-link__link govuk-!-font-weight-bold govuk-link govuk-link--no-visited-state">

                                                <span class="ataglance-link__iconbox"
                                                      aria-hidden="true">

                                                    <svg class="ataglance-link__icon"
                                                         viewBox="0 0 32 32"
                                                         focusable="false"
                                                         aria-hidden="true">

                                                        <circle cx="16"
                                                                cy="16"
                                                                r="14"
                                                                fill="currentColor" />

                                                        <path d="M9 15h9.5l-3.5-3.5 1.8-1.8L23 16l-6.2 6.3-1.8-1.8 3.5-3.5H9z"
                                                              fill="#ffffff" />

                                                    </svg>

                                                </span>

                                                <span class="ataglance-link__text">
                                                    View breakdowns of pupils in education, apprenticeships or employment
                                                </span>

                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                
                
                    @* Extra-curricular activities - closed by default *@
                    <div class="govuk-accordion__section">

                        <div class="govuk-accordion__section-header">

                            <span id="accordion-iconbox__extra-curricular"
                                  class="ataglance-accordion-iconbox"
                                  aria-hidden="true">

                                <img src="~/assets/images/at-a-glance-extra-curricular-icon.svg"
                                     class="ataglance-accordion-iconbox__icon"
                                     alt="" />

                            </span>

                            <h3 class="govuk-accordion__section-heading">
                                <span class="govuk-accordion__section-button"
                                      id="accordion-extra-curricular-heading">
                                    Extra-curricular activities
                                </span>
                            </h3>

                        </div>

                        <div id="secondary-at-a-glance-accordion-content-5"
                             class="govuk-accordion__section-content">

                            <div class="govuk-body">

                                <div class="ataglance-summary-card govuk-summary-card">

                                    <div class="govuk-summary-card__title-wrapper">
                                        <h4 class="govuk-summary-card__title">
                                            Find out more about upcoming information on extra-curricular activities
                                        </h4>
                                    </div>

                                    <div class="govuk-summary-card__content">

                                        <p class="govuk-body">
                                            Information on extra-curricular opportunities will be available in the future.
                                        </p>

                                        <div class="govuk-body">

                                            <a asp-route="@RouteConstants.SecondaryCurriculumAndExtraCurricularActivities"
                                               asp-all-route-data="@Model.RouteAttributes"
                                               class="ataglance-link__link govuk-!-font-weight-bold govuk-link govuk-link--no-visited-state">

                                                <span class="ataglance-link__iconbox"
                                                      aria-hidden="true">

                                                    <svg class="ataglance-link__icon"
                                                         viewBox="0 0 32 32"
                                                         focusable="false"
                                                         aria-hidden="true">

                                                        <circle cx="16"
                                                                cy="16"
                                                                r="14"
                                                                fill="currentColor" />

                                                        <path d="M9 15h9.5l-3.5-3.5 1.8-1.8L23 16l-6.2 6.3-1.8-1.8 3.5-3.5H9z"
                                                              fill="#ffffff" />

                                                    </svg>

                                                </span>

                                                <span class="ataglance-link__text">
                                                    Find out more about what types of activities pupils can take part in and where to find this information
                                                </span>

                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                </div>

            </section>
        }

        @* Next steps *@
        <section class="govuk-!-margin-top-8" id="overview-next-steps">

            <h2 class="govuk-heading-xl">
                Next steps
            </h2>

            <div class="govuk-summary-card">

                <div class="govuk-summary-card__title-wrapper">
                    <h3 class="govuk-summary-card__title">
                        Continue exploring this school’s profile
                    </h3>
                </div>

                <div class="govuk-summary-card__content">

                    @foreach (var link in Model.NextStepLinks)
                    {
                        <div class="ataglance-next-step">

                            <h4 class="govuk-heading-s govuk-!-margin-bottom-1">
                                <a asp-route="@link.RouteName"
                                   asp-all-route-data="@Model.RouteAttributes"
                                   class="govuk-link govuk-link--no-visited-state">
                                    @link.Title
                                </a>
                            </h4>

                            <p class="govuk-body govuk-!-margin-bottom-5">
                                @link.Description
                            </p>

                        </div>
                    }

                </div>

            </div>

            @if (Model.IsKS4)
            {
                <div class="govuk-summary-card govuk-!-margin-top-6">

                    <div class="govuk-summary-card__title-wrapper">
                        <h3 class="govuk-summary-card__title">
                            Save this school to my schools list
                        </h3>
                    </div>

                    <div class="govuk-summary-card__content">

                        <p class="govuk-body">
                            Save a school to your schools list to find it again later, create a shortlist, and compare it with other saved schools.
                        </p>

                        @await Component.InvokeAsync(
                            "AddSchoolButton",
                            new
                            {
                                urn = Model.URN,
                                isKS4 = Model.IsKS4
                            })

                    </div>

                </div>
            }

        </section>


        @await Component.InvokeAsync(
            "SchoolProfilePagination",
            SchoolProfilePaginationModel.From(
                Model,
                RouteConstants.Overview))

    </div>

</div>


@section Scripts {
    <script nonce="@Html.ScriptNonce().ToString()"
            src="~/js/map-schools.js"></script>

    <script nonce="@Html.ScriptNonce().ToString()"
            src="~/js/chart.umd.js"></script>

    <script nonce="@Html.ScriptNonce().ToString()"
            src="~/js/chartjs-plugin-datalabels.min.js"></script>

    <script nonce="@Html.ScriptNonce().ToString()"
            src="~/js/chart-factory.js"></script>

    <script nonce="@Html.ScriptNonce().ToString()"
            src="~/js/overview.js"></script>

    <script nonce="@Html.ScriptNonce().ToString()">
        document.addEventListener('DOMContentLoaded', () => {
            const notification =
                document.querySelector(
                    '[id$="-add-success"], [id$="-remove-success"]');

            if (!notification) {
                return;
            }

            notification.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });

            notification.setAttribute('tabindex', '-1');
            notification.focus({ preventScroll: true });
        });
    </script>
}
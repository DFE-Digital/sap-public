@model SAPPub.Web.Areas.Profiles.ViewModels.Overview.OverviewViewModel

@using SAPPub.Web.Constants
@using SAPPub.Web.Helpers
@using SAPPub.Web.ViewComponents.SchoolProfilePagination
@using SAPPub.Web.ViewComponents.VerticalNavigation

@{
    ViewData["Header"] = "Overview";
    ViewData["Title"] = $"{Model.SchoolName} - {ViewData["Header"]}";
}


<div class="govuk-grid-row">

    @await Component.InvokeAsync(
    "VerticalNavigation",
        new VerticalNavigationModel
        {
            URN = Model.URN,
            SchoolName = Model.SchoolName,
            ActivePage = RouteConstants.Overview,
            IsKS2 = Model.IsKS2,
            IsKS4 = Model.IsKS4,
            IsKS5 = Model.IsKS5
        })

    <div class="govuk-grid-column-three-quarters">

        <h2 class="govuk-heading-xl govuk-!-margin-bottom-4">
            Overview
        </h2>

        @*
            Map and address
            The map container starts visually hidden so that with JavaScript
            disabled the map is not shown. map-schools.js reveals it when
            the map can be initialised.
        *@
        <div class="map-address govuk-!-margin-bottom-5">

            <div class="map-container govuk-visually-hidden">
                <div id="map"
                     data-radius-miles="3"
                     data-fixed-zoom="14"
                     data-lat="@Model.Latitude"
                     data-lon="@Model.Longitude"
                     data-name="@Model.SchoolName"
                     role="region"
                     aria-label="Map showing the location of @Model.SchoolName">
                    <div class="map-loading">Loading Map…</div>
                </div>
            </div>

            <div class="ataglance-address-row">
                <div class="ataglance-address-row__key">
                    Address
                </div>

                <div class="ataglance-address-row__value">
                    @Model.Address.DisplayText()
                </div>
            </div>

        </div>


        <div class="ataglance-card">

            <govuk-summary-list id="overview-school-information">

                <govuk-summary-list-row id="overview-phase">
                    <govuk-summary-list-row-key>
                        Phase of education
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @Model.EducationPhase.DisplayText()
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row id="overview-age-range">
                    <govuk-summary-list-row-key>
                        Age range
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @Model.AgeRange.DisplayText()
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row id="overview-pupil-count">
                    <govuk-summary-list-row-key>
                        Number of pupils
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @Model.NumberOfPupils.DisplayText()
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row id="overview-sen">
                    <govuk-summary-list-row-key>
                        Type of SEN provision
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @Model.SenTypes.DisplayText()
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row id="overview-phone">
                    <govuk-summary-list-row-key>
                        Phone
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @if (Model.Telephone.IsAvailable)
                        {
                            <a class="govuk-link govuk-link--no-visited-state"
                               href="tel:@Model.Telephone.Value">
                                @Model.Telephone.Value
                            </a>
                        }
                        else
                        {
                            @Model.Telephone.DisplayText()
                        }
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row id="overview-website">
                    <govuk-summary-list-row-key>
                        Website
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @if (Model.SchoolWebsite.IsAvailable)
                        {
                            <a class="govuk-link govuk-link--no-visited-state"
                               href="@Model.SchoolWebsite.DisplayText(UrlHelper.EnsureHttpsUrl)"
                               target="_blank"
                               rel="noreferrer noopener">
                                View @Model.SchoolName's website
                                <span class="govuk-visually-hidden">
                                    (opens in a new tab)
                                </span>
                            </a>
                        }
                        else
                        {
                            @Model.SchoolWebsite.DisplayText()
                        }
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row>
                    <govuk-summary-list-row-key>
                        Ofsted report
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        <a class="govuk-link govuk-link--no-visited-state"
                           href="@Model.OfstedReportUrl"
                           target="_blank"
                           rel="noreferrer noopener">
                            View the latest Ofsted report
                            <span class="govuk-visually-hidden">
                                (opens in a new tab)
                            </span>
                        </a>
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

            </govuk-summary-list>

            <div class="govuk-body govuk-!-margin-top-5">

                <a asp-route="@RouteConstants.AboutTheSchool"
                   asp-all-route-data="@Model.RouteAttributes"
                   class="ataglance-link__link govuk-!-font-weight-bold govuk-link govuk-link--no-visited-state">

                    <span class="ataglance-link__iconbox"
                          aria-hidden="true">

                        <svg class="ataglance-link__icon"
                             width="32"
                             height="32"
                             viewBox="0 0 32 32"
                             focusable="false"
                             aria-hidden="true">
                            <circle cx="16"
                                    cy="16"
                                    r="15"
                                    fill="currentColor" />
                            <path d="M9 15h10.2l-4.1-4.1 1.9-1.9 7.3 7-7.3 7-1.9-1.9 4.1-4.1H9z"
                                  fill="#ffffff" />
                        </svg>

                    </span>

                    <span class="ataglance-link__text">
                        @if (Model.IsExclusivelyKS5)
                        {
                            <text>
                                Find out more about the school or college, including policies on school uniform and SEN
                            </text>
                        }
                        else
                        {
                            <text>
                                Find out more about the school, including policies on school uniform and SEN
                            </text>
                        }
                    </span>

                </a>

            </div>

        </div>

        @if (Model.IsKS4)
{
    <section aria-labelledby="secondary-at-a-glance-heading"
             class="govuk-!-margin-top-7">

        <h2 id="secondary-at-a-glance-heading"
            class="govuk-heading-l">
            Secondary school profile at a glance
        </h2>

        <div class="ataglance-accordion govuk-accordion"
             data-module="govuk-accordion"
             id="secondary-at-a-glance-accordion">

            <div class="govuk-accordion__section">

                <div class="govuk-accordion__section-header">

                    <span id="accordion-iconbox__progress"
                          class="ataglance-accordion-iconbox"
                          aria-hidden="true">

                        <svg class="ataglance-accordion-iconbox__icon"
                             viewBox="0 0 48 48"
                             focusable="false"
                             aria-hidden="true">
                            <circle cx="10"
                                    cy="15"
                                    r="4"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="4" />

                            <circle cx="38"
                                    cy="38"
                                    r="6"
                                    fill="currentColor" />

                            <path d="M14 15h10
                                     c4.5 0 7 2.5 7 6
                                     s-2.5 6-7 6h-5
                                     c-4.5 0-7 2.5-7 6
                                     s2.5 6 7 6h15"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="4"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>

                    </span>

                    <h3 class="govuk-accordion__section-heading">
                        <span class="govuk-accordion__section-button"
                              id="accordion-progress-heading">
                            Pupil progress
                        </span>
                    </h3>

                </div>

                <div id="accordion-progress-content"
                     class="govuk-accordion__section-content">

                    <div class="govuk-body">

                        <div class="ataglance-summary-card govuk-summary-card">

                            <div class="govuk-summary-card__title-wrapper">
                                <h4 class="govuk-summary-card__title">
                                    How pupils performed between the end of primary school and the end of key stage 4 (year 11)
                                </h4>
                            </div>

                            <div class="govuk-summary-card__content">

                                <p class="govuk-body">
                                    Progress 8 measures the progress pupils make between the end of primary school and the end of key stage 4 across their best-performing eight subjects.
                                </p>

                                <p class="govuk-body">
                                    Progress scores are not available for the academic years 2024 to 2025 and 2025 to 2026 due to COVID-19 disruption.
                                </p>

                                <p class="govuk-body">
                                    You can view progress results from previous years on the school's full profile.
                                </p>

                                <div class="govuk-body">

                                    <a asp-route="@RouteConstants.SecondaryAcademicPerformanceAttainmentAndProgress"
                                       asp-all-route-data="@Model.RouteAttributes"
                                       class="ataglance-link__link govuk-!-font-weight-bold govuk-link govuk-link--no-visited-state">

                                        <span class="ataglance-link__iconbox"
                                              aria-hidden="true">

                                            <svg class="ataglance-link__icon"
                                                 viewBox="0 0 32 32"
                                                 focusable="false"
                                                 aria-hidden="true">
                                                <circle cx="16"
                                                        cy="16"
                                                        r="14"
                                                        fill="currentColor" />
                                                <path d="M9 15h9.5l-3.5-3.5 1.8-1.8L23 16l-6.2 6.3-1.8-1.8 3.5-3.5H9z"
                                                      fill="#ffffff" />
                                            </svg>

                                        </span>

                                        <span class="ataglance-link__text">
                                            Find out more about the progress pupils make at this school for previous years
                                        </span>

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </section>
}

        @*
            Phase-specific "at a glance" accordions will be added here
            in the subsequent content stories.
        *@


        @await Component.InvokeAsync(
        "SchoolProfilePagination",
                SchoolProfilePaginationModel.From(
                Model,
                RouteConstants.Overview))

    </div>
</div>


@section Scripts {
    <script nonce="@Html.ScriptNonce().ToString()"
            src="~/js/map-schools.js"></script>
}
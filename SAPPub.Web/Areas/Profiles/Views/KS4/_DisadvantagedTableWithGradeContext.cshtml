@using SAPPub.Web.Constants
@using SAPPub.Web.Models.Charts
@using SAPPub.Core.Extensions
@model SeriesMeasureViewModel

<table id="@Model.TableId" class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">@Model.TableHeader</th>
            @foreach (var label in Model.Labels)
            {
                <th scope="col" class="govuk-table__header">@label</th>
            }
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var dataset in Model.Datasets)
        {
            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">@dataset.Label</th>
                @foreach (var data in dataset.Data)
                {
                    <td class="govuk-table__cell">@data.DisplayText(Constants.NotAvailable)</td>
                    <td class="govuk-table__cell">
                        @{
                            var statement = AttainmentHelper.EstablishmentAttainment8ContextStatement(data.Value.Value);

                            @(string.IsNullOrEmpty(statement)
                                ? statement
                                : char.ToUpper(statement[0]) + statement[1..])
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

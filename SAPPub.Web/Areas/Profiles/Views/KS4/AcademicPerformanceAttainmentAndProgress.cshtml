@model AcademicPerformanceAttainmentAndProgressViewModel
@using SAPPub.Web.Areas.Profiles.ViewModels.KS4
@using SAPPub.Web.Constants
@using SAPPub.Web.ViewComponents.SchoolProfilePagination
@using SAPPub.Web.ViewComponents.VerticalNavigation
@using static SAPPub.Web.Constants.PageTitleConstants

@{
    ViewData["Header"] = "Academic performance";
    ViewData["SubHeader"] = PageTitleConstants.SecondarySchoolPageTitles.ProgressAndAttainment;
    ViewData["Title"] = $"{Model.SchoolName} - Secondary {ViewData["SubHeader"]}";
}

<div class="govuk-grid-row">
    @await Component.InvokeAsync("VerticalNavigation",
    new VerticalNavigationModel
    {
        URN = Model.URN,
        SchoolName = Model.SchoolName,
        ActivePage = RouteConstants.SecondaryAcademicPerformanceAttainmentAndProgress,
        IsKS2 = Model.IsKS2,
        IsKS4 = Model.IsKS4,
        IsKS5 = Model.IsKS5
    })

    <div class="govuk-grid-column-three-quarters">
        <h2 class="govuk-heading-xl">@ViewData["Header"]</h2>
        <p class="govuk-body">
            Looking at school performance data is one way to see how well a school is doing.
            You should look at a range of information about a school before deciding if it’s the right fit for your child.
        </p>

        <nav id="sub-navigation-academic-performance" class="moj-sub-navigation" aria-label="Sub navigation">
            <ul class="moj-sub-navigation__list">
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" aria-current="page" asp-route="@RouteConstants.SecondaryAcademicPerformanceAttainmentAndProgress" asp-all-route-data="@Model.RouteAttributes">@SecondarySchoolPageTitles.ProgressAndAttainment</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.SecondaryAcademicPerformanceEnglishAndMathsResults" asp-all-route-data="@Model.RouteAttributes">@SecondarySchoolPageTitles.EnglishAndMathsResultsTab</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.SecondaryAcademicPerformanceSubjectsEntered" asp-all-route-data="@Model.RouteAttributes">@SecondarySchoolPageTitles.SubjectsEntered</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.SecondaryAcademicPerformanceAdditionalMeasures" asp-all-route-data="@Model.RouteAttributes">@SecondarySchoolPageTitles.AdditionalMeasures</a>
                </li>
            </ul>
        </nav>

        <h2 class="govuk-heading-l">Pupil @ViewData["SubHeader"]?.ToString()?.ToLower()</h2>

        <p class="govuk-body" data-testid="academic-year-info">@Model.AcademicYearInfoParagraph</p>

        <form method="get" asp-route="@RouteConstants.SecondaryAcademicPerformanceAttainmentAndProgress" asp-all-route-data="@Model.RouteAttributes">
            <div id="filterSection" class="select-filter">
                <label for="academicYearSelector" class="govuk-label govuk-!-font-weight-bold">Choose the academic year you want to see results for</label>
                <select id="academicYearSelector" class="govuk-select" asp-for="SelectedAcademicYear" asp-items="Model.AcademicYearsSelectList"></select>
                <govuk-button type="submit">Show results</govuk-button>
            </div>
        </form>

        <h3 class="govuk-heading-m">Progress 8</h3>

        <p class="govuk-body">
            Progress 8 measures a school’s performance. It shows how much progress pupils make from the end of primary school (KS2) to the end of secondary school (KS4), across 8 qualifications.
        </p>

        <ul class="govuk-list govuk-list--bullet">
            <li>
                A score of zero means pupils made about the same progress as similar pupils across England.
            </li>
            <li>
                A positive score means pupils made more progress than similar pupils across England.
            </li>
            <li>
                A negative score means pupils made less progress than similar pupils across England.
            </li>
        </ul>

        @if (Model.ShowUTCCaveat)
        {
            <govuk-inset-text id="utc-caveat-inset-text">
                <p class="govuk-body">
                    Some schools start educating pupils partway through the 5-year period covered by Progress 8, which should be taken into account when comparing their results with schools that start at Key Stage 3.
                </p>
                <p class="govuk-body">
                    Progress 8 is not the most appropriate performance measure for university technical colleges, studio schools and some further education colleges. These establishments typically start educating pupils at age 14, with a focus on preparing pupils for their future careers by providing an integrated academic and professional education. Other headline measures, particularly pupil destinations, are more important for these establishments.
                </p>

                <p class="govuk-body">
                    University Technical Colleges (UTCs) are state-funded mainstream schools that focus on technical qualifications from age 14 alongside core academic subjects, including maths, English and science.
                    Employers are closely involved in the design and delivery of technical education at UTCs.
                </p>
            </govuk-inset-text>
        }

        @if (Model.ShowStudioSchoolCaveat)
        {
            <govuk-inset-text id="studioschool-caveat-inset-text">
                <p class="govuk-body">
                    Some schools start educating pupils partway through the 5-year period covered by Progress 8, which should be taken into account when comparing their results with schools that start at Key Stage 3.
                </p>
                <p class="govuk-body">
                    Progress 8 is not the most appropriate performance measure for university technical colleges, studio schools and some further education colleges.
                    These establishments typically start educating pupils at age 14, with a focus on preparing pupils for their future careers by providing an
                    integrated academic and professional education. Other headline measures, particularly pupil destinations, are more important for these establishments.
                </p>
                <p class="govuk-body">
                    Studio Schools are state-funded mainstream schools that focus on vocational qualifications from age 14 alongside core academic subjects, including maths, English and science.
                    Studio schools have an emphasis on developing employability skills taught through project based learning.
                </p>
            </govuk-inset-text>
        }

        @if (Model.ShowFurtherEducationCaveat)
        {
            <govuk-inset-text id="fe-caveat-inset-text">
                <p class="govuk-body">
                    Some schools start educating pupils partway through the 5-year period covered by Progress 8, which should be taken into account when comparing their results with schools that start at Key Stage 3.
                </p>
                <p class="govuk-body">
                    Progress 8 is not the most appropriate performance measure for university technical colleges, studio schools and some further education colleges. These establishments typically start educating pupils at age 14, with a focus on preparing pupils for their future careers by providing an integrated academic and professional education. Other headline measures, particularly pupil destinations, are more important for these establishments.

                </p>
            </govuk-inset-text>
        }

        <govuk-details id="details-progress8">
            <govuk-details-summary>
                Find out more about Progress 8 confidence intervals
            </govuk-details-summary>
            <govuk-details-text>
                <p class="govuk-body">
                    Progress 8 scores are influenced by both the school and their pupils. It is difficult to determine how much of the progress score is due to the school and how much is due to the pupils themselves. Confidence intervals reflect this uncertainty.
                </p>

                <p class="govuk-body">
                    If the confidence intervals for two schools overlap, it means we cannot be sure that one school’s Progress 8 score is better than the other.
                </p>

                <p class="govuk-body">
                    The greater the number of pupils, the smaller the range of the confidence interval. Smaller schools have larger confidence intervals because fewer pupils are included, so the score is more affected by the performance of individual pupils.  
                </p>

                <p class="govuk-body">
                    A school is above average if its Progress 8 score is above 0 and the entire confidence interval is above 0.
                </p>
                <p class="govuk-body">
                    A school is below average if its Progress 8 score is below 0 and the entire confidence interval is below 0.
                </p>

                <p class="govuk-body">
                    Read more about how confidence intervals are used in the <a class="govuk-link govuk-link--no-visited-state" href="https://www.gov.uk/government/publications/progress-8-school-performance-measure" rel="nofollow noreferrer" target="_blank">secondary accountability measures guidance</a>.
                </p>


            </govuk-details-text>
        </govuk-details>

        @if (Model.ShowProgress8NotAvailableInfo)
        {
            <div class="custom-card" data-testid="progress8-custom-card">
                <div class="info__icon"></div>
                <div class="custom-card__content">
                    <p class="govuk-body">
                        There are no Progress 8 scores available for the academic years 2024 to 2025 and 2025 to 2026. This is because there is no KS2 baseline available to calculate secondary progress measures for these years due to COVID-19 disruption.
                    </p>
                </div>
            </div>
        }
        else
        {
            @await Html.PartialAsync("_Progress8Scores", Model.YearValues.CurrentYear, new ViewDataDictionary(ViewData) { { "id", "prog8-scores-current" } })
        }

        <govuk-accordion id="prog8-previous-years-accordion" heading-level="3" hide-all-sections-text="Hide all sections" show-all-sections-text="Show all sections" hide-section-text="Hide" show-section-text="Show more">
            <govuk-accordion-item expanded="false">
                <govuk-accordion-item-heading>Progress 8 for previous years</govuk-accordion-item-heading>
                <govuk-accordion-item-content>

                    <h4 class="govuk-heading-m">@Model.YearValues.PreviousYear!.AcademicYearSelection.GetDisplayName() academic year</h4>
                    @await Html.PartialAsync("_Progress8Scores", Model.YearValues.PreviousYear, new ViewDataDictionary(ViewData) { { "id", "prog8-scores-prev" } })

                    <h4 class="govuk-heading-m">@Model.YearValues.TwoYearsAgo!.AcademicYearSelection.GetDisplayName() academic year</h4>
                    @await Html.PartialAsync("_Progress8Scores", Model.YearValues.TwoYearsAgo, new ViewDataDictionary(ViewData) { { "id", "prog8-scores-prev2" } })

                </govuk-accordion-item-content>
            </govuk-accordion-item>
        </govuk-accordion>

        
        <h3 class="govuk-heading-m">Attainment 8</h3>

        <p class="govuk-body">
            Attainment 8 is used to assess a pupil’s average achievement across their 8 best GCSE-level subjects.
        </p>

        <govuk-details id="details-attainment8">
            <govuk-details-summary>
                Find out more about Attainment 8
            </govuk-details-summary>
            <govuk-details-text>
                <p class="govuk-body">
                    The 8 subjects that are used in Attainment 8 are split into 3 groups:
                </p>

                <ul class="govuk-list govuk-list--bullet">
                    <li>
                        English and maths, which are both double-weighted
                    </li>
                    <li>
                        other subjects including sciences, geography, history and languages
                    </li>
                    <li>
                        any other approved GCSEs or vocational qualifications
                    </li>
                </ul>

                <p class="govuk-body">
                    Each GCSE grade is given a point score (for example grade 9 = 9 points, grade 8 = 8 points, and so on).
                    The scores from the best 8 subjects (with English and maths counting twice) are added together to give the Attainment 8 score.
                </p>

                <p class="govuk-body">
                    If a student scores high grades across these subjects, their Attainment 8 score will be higher.  The maximum score a pupil can have is 90.
                </p>
            </govuk-details-text>
        </govuk-details>

        @await Html.PartialAsync("_Attainment8Scores", Model.YearValues.CurrentYear, new ViewDataDictionary(ViewData) { { "id", "attainment8-scores-current" } })
            
        <govuk-accordion id="attainment8-previous-years-accordion" heading-level="3" hide-all-sections-text="Hide all sections" show-all-sections-text="Show all sections" hide-section-text="Hide" show-section-text="Show more">
            <govuk-accordion-item expanded="false">
                <govuk-accordion-item-heading>Attainment 8 for previous years</govuk-accordion-item-heading>
                <govuk-accordion-item-content>

                    <h4 class="govuk-heading-m">@Model.YearValues.PreviousYear!.AcademicYearSelection.GetDisplayName() academic year</h4>
                    @await Html.PartialAsync("_Attainment8Scores", Model.YearValues.PreviousYear, new ViewDataDictionary(ViewData) { { "id", "attainment8-scores-prev" } })
                    <h4 class="govuk-heading-m">@Model.YearValues.TwoYearsAgo!.AcademicYearSelection.GetDisplayName() academic year</h4>
                    @await Html.PartialAsync("_Attainment8Scores", Model.YearValues.TwoYearsAgo, new ViewDataDictionary(ViewData) { { "id", "attainment8-scores-prev2" } })

                </govuk-accordion-item-content>
            </govuk-accordion-item>
        </govuk-accordion>

           
        <govuk-accordion heading-level="3" id="other-pupil-characteristics-accordion" hide-all-sections-text="Hide all sections" show-all-sections-text="Show all sections" hide-section-text="Hide" show-section-text="Show more">
            <govuk-accordion-item>
                <govuk-accordion-item-heading>Attainment 8 by pupil characteristic</govuk-accordion-item-heading>
                <govuk-accordion-item-summary></govuk-accordion-item-summary>
                <govuk-accordion-item-content>

                    @await Html.PartialAsync("_DisadvantagedPupils")
                    @await Html.PartialAsync("_DisadvantagedTableWithGradeContext", Model.YearValues.CurrentYear.BreakdownDisadvantaged)
                    <govuk-details id="non-disadvantaged-details">
                        <govuk-details-summary>
                            Compare state-funded local and national averages for non-disadvantaged pupils
                        </govuk-details-summary>
                        <govuk-details-text>
                            <h4 class="govuk-heading-s">Non-disadvantaged pupils</h4>
                            @await Html.PartialAsync("_DisadvantagedTableWithGradeContext", Model.BreakdownNonDisadvantaged)
                        </govuk-details-text>
                    </govuk-details>

                    <govuk-details id="disadvantaged-previous-years-details">
                        <govuk-details-summary>
                            Show previous years data for disadvantaged pupils
                        </govuk-details-summary>
                        <govuk-details-text>
                            <h4 class="govuk-heading-s">@Model.YearValues.PreviousYear!.AcademicYearSelection.GetDisplayName() academic year</h4>
                            @await Html.PartialAsync("_DisadvantagedTableWithGradeContext", Model.YearValues.PreviousYear?.BreakdownDisadvantaged)
                            <h4 class="govuk-heading-s">@Model.YearValues.TwoYearsAgo!.AcademicYearSelection.GetDisplayName() academic year</h4>
                            @await Html.PartialAsync("_DisadvantagedTableWithGradeContext", Model.YearValues.TwoYearsAgo?.BreakdownDisadvantaged)
                        </govuk-details-text>
                    </govuk-details>
                </govuk-accordion-item-content>
            </govuk-accordion-item>
        </govuk-accordion>


        @await Component.InvokeAsync("SchoolProfilePagination", SchoolProfilePaginationModel.From(Model, RouteConstants.SecondaryAcademicPerformanceAttainmentAndProgress))

    </div>
</div>

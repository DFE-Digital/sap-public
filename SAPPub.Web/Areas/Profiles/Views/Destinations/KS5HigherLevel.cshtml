@model KS5DestinationsViewModel;
@using SAPPub.Web.Areas.Profiles.ViewModels.Destinations
@using SAPPub.Web.Constants
@using SAPPub.Web.ViewComponents.SchoolProfilePagination
@using SAPPub.Web.ViewComponents.VerticalNavigation

@{
    ViewData["Header"] = PageTitleConstants.KS5SchoolPageTitles.Destinations;
    ViewData["Title"] = $"{Model.SchoolName} - {PageTitleConstants.KS5SchoolPageTitles.DestinationsHigherUrl}";
}

<div class="govuk-grid-row">
    @await Component.InvokeAsync("VerticalNavigation",
    new VerticalNavigationModel
    {
        URN = Model.URN,
        SchoolName = Model.SchoolName,
        ActivePage = RouteConstants.KS5Destinations,
        IsKS2 = Model.IsKS2,
        IsKS4 = Model.IsKS4,
        IsKS5 = Model.IsKS5
    })

    <div class="govuk-grid-column-three-quarters">
        <h2 class="govuk-heading-xl govuk-!-margin-bottom-4">@ViewData["Header"]</h2>

        <p class="govuk-body" data-testId="looking-at-school-performance-info">
            Looking at school performance data is one way to see how well a school is doing.
            You should look at a range of information about a school before deciding if it’s the right fit for your child.
        </p>


        <nav id="sub-navigation-academic-performance" class="moj-sub-navigation" aria-label="Sub navigation">
            <ul class="moj-sub-navigation__list">
                @if (Model.IsKS4 == true)
                {
                    <li class="moj-sub-navigation__item">
                        <a class="moj-sub-navigation__link" asp-route="@RouteConstants.SecondaryDestinations" asp-all-route-data="@Model.RouteAttributes">@PageTitleConstants.SecondarySchoolPageTitles.Destinations</a>
                    </li>
                }

                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.KS5Destinations" asp-all-route-data="@Model.RouteAttributes">@PageTitleConstants.KS5SchoolPageTitles.DestinationsFullTitle</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" aria-current="page" asp-route="@RouteConstants.KS5DestinationsHigher" asp-all-route-data="@Model.RouteAttributes">@PageTitleConstants.KS5SchoolPageTitles.DestinationsHigherFullTitle</a>
                </li>
            </ul>
        </nav>

        <h2 class="govuk-heading-l">
            Breakdown of all students, including disadvantaged students
        </h2>

        <govuk-inset-text id="breakdown-disadvantaged-students-inset-text">
            <p class="govuk-body">
                Destination measures including disadvantaged and non-disadvantaged students are not currently available.
                We plan to make this information available in a future release.
            </p>

            <p class="govuk-body">
                The measures will cover students who completed 16 to 19 study in 2021 to 2022 and then 
                progressed to either:
            </p>

            <ul class="govuk-list govuk-list--bullet">
                <li>
                    a degree
                </li>
                <li>
                    a higher apprenticeship
                </li>
                <li>
                    other level 4 or above study 
                </li>            
            </ul>

            <p class="govuk-body">
                <a id="find-statistics-link"
                   class="govuk-link"
                   rel="noreferrer noopener"
                   target="_blank"
                   href="https://explore-education-statistics.service.gov.uk/find-statistics">
                    Find out more about statistics and data <span class="govuk-visually-hidden">(opens in a new tab)</span>
                </a>.
            </p>
        </govuk-inset-text>

        @await Component.InvokeAsync("SchoolProfilePagination", SchoolProfilePaginationModel.From(Model, RouteConstants.KS5DestinationsHigher))

    </div>
</div>

@section Scripts {
    <script src="~/js/chart.umd.js"></script>
    <script src="~/js/chartjs-plugin-datalabels.min.js"></script>
    <script src="~/js/chart-factory.js"></script>
    <script src="~/js/destinations.js"></script>
}
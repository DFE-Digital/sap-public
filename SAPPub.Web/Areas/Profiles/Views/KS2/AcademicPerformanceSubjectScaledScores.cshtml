@model SAPPub.Web.Areas.Profiles.ViewModels.KS2.AcademicPerformanceSubjectScaledScoresViewModel
@using SAPPub.Web.Constants
@using SAPPub.Web.ViewComponents.ChartWithTableToggle
@using SAPPub.Web.ViewComponents.VerticalNavigation
@using static SAPPub.Web.Constants.PageTitleConstants

@{
    ViewData["Header"] = "Academic performance";
    ViewData["SubHeader"] = PageTitleConstants.PrimarySchoolPageTitles.SubjectScaledScores;
    ViewData["Title"] = $"{Model.SchoolName} - Primary {ViewData["SubHeader"]}";
}

<div class="govuk-grid-row">
    @await Component.InvokeAsync("VerticalNavigation",
    new VerticalNavigationModel
    {
        URN = Model.URN,
        SchoolName = Model.SchoolName,
        ActivePage = RouteConstants.PrimaryAcademicPerformanceSubjectScaledScores,
        IsKS2 = Model.IsKS2,
        IsKS4 = Model.IsKS4,
        IsKS5 = Model.IsKS5
    })

    <div class="govuk-grid-column-three-quarters">
        <span id="school-name-caption" class="govuk-caption-xl">@Model.SchoolName</span>
        <h1 class="govuk-heading-xl">@ViewData["Header"]</h1>
        <p class="govuk-body">
            Looking at school performance data is one way to see how well a school is doing.
            You should look at a range of information about a school before deciding if it’s the right fit for your child.
        </p>

        <nav id="sub-navigation-academic-performance" class="moj-sub-navigation" aria-label="Sub navigation">
            <ul class="moj-sub-navigation__list">
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.PrimaryAcademicPerformancePupilProgress" asp-all-route-data="@Model.RouteAttributes">@PrimarySchoolPageTitles.PupilProgress</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.PrimaryAcademicPerformanceMeetingOrExceedingStandards" asp-all-route-data="@Model.RouteAttributes">@PrimarySchoolPageTitles.MeetingOrExceedingStandards</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" aria-current="page" asp-route="@RouteConstants.PrimaryAcademicPerformanceSubjectScaledScores" asp-all-route-data="@Model.RouteAttributes">@PrimarySchoolPageTitles.SubjectScaledScores</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.PrimaryAcademicPerformanceAdditionalMeasures" asp-all-route-data="@Model.RouteAttributes">@PrimarySchoolPageTitles.AdditionalMeasures</a>
                </li>
            </ul>
        </nav>

        <h2 class="govuk-heading-l">Scaled scores in reading and maths for the previous academic year</h2>

        <p class="govuk-body">
            Information in this section is for the 2024 to 2025 academic year
        </p>

        <p class="govuk-body">
            These measures show pupils’ average scaled scores in reading and maths.
        </p>

        <p class="govuk-body">
            Pupils sit national tests in English reading and maths, typically when they are aged 10 or 11 and in year 6. The score they get on their test is converted into a scaled score.
        </p>

        <p class="govuk-body">
            The lowest scaled score a pupil can achieve is 80 and the highest is 120. When pupils achieve a scaled score of:
        </p>

        <ul>
            <li>100 or higher, they achieve the expected standard</li>
            <li>110 or higher, they achieve a higher standard</li>
        </ul>

        <div class="data-container">
            <h3 id="chartHeading" class="govuk-heading-m govuk-heading-m govuk-!-margin-top-3">
                Average scaled score in reading
            </h3>


            <p class="govuk-body">
                The lowest scaled score a pupil can achieve is 80 and the highest is 120. A scaled score of 100 is the expected standard.
            </p>

            @await Component.InvokeAsync("ChartWithTableToggle", new ChartWithTableToggleModel
            {
                IdPrefix = "read",
                ChartPrefix = "read",
                CurrentData = Model.AllReadData,
                OverTimeData = Model.AllReadOverTimeData,
                HasEstablishmentData = Model.HasReadEstablishmentData.IsAvailable,
                IsScaled = true,
                IsPercentageData = false
            })
        </div>

        <div class="data-container">
            <h3 id="chartHeading" class="govuk-heading-m govuk-heading-m govuk-!-margin-top-3">
                Average scaled score in maths
            </h3>


            <p class="govuk-body">
                The lowest scaled score a pupil can achieve is 80 and the highest is 120. A scaled score of 100 is the expected standard.
            </p>

            @await Component.InvokeAsync("ChartWithTableToggle", new ChartWithTableToggleModel
            {
                IdPrefix = "maths",
                ChartPrefix = "maths",
                CurrentData = Model.AllMathsData,
                OverTimeData = Model.AllMathsOverTimeData,
                HasEstablishmentData = Model.HasMathsEstablishmentData.IsAvailable,
                IsScaled = true,
                IsPercentageData = false
            })
        </div>

        <govuk-pagination id="bottom-pagination">
            <govuk-pagination-previous asp-route="@RouteConstants.PrimaryAcademicPerformancePupilProgress" asp-all-route-data="@Model.RouteAttributes">Primary academic performance: Pupil progress</govuk-pagination-previous>
            @if (Model.IsKS4)
            {
                <govuk-pagination-next asp-route="@RouteConstants.SecondaryAcademicPerformanceAttainmentAndProgress" asp-all-route-data="@Model.RouteAttributes">Secondary academic performance: Progress and attainment</govuk-pagination-next>
            }
        </govuk-pagination>
    </div>
</div>



@section Scripts {
    <script src="~/js/chart.umd.js"></script>
    <script src="~/js/chartjs-plugin-datalabels.min.js"></script>
    <script src="~/js/chart-factory.js"></script>
    <script src="~/js/chart-table-toggle.js"></script>
}
@model SAPPub.Web.Areas.Profiles.ViewModels.KS2.AcademicPerformanceSubjectScaledScoresViewModel
@using SAPPub.Web.Constants
@using SAPPub.Web.ViewComponents.ChartWithTableToggle
@using SAPPub.Web.ViewComponents.SchoolProfilePagination
@using SAPPub.Web.ViewComponents.VerticalNavigation
@using static SAPPub.Web.Constants.PageTitleConstants
@using static SAPPub.Web.Constants.Constants;
@inject Microsoft.FeatureManagement.IFeatureManager FeatureManager

@{
    ViewData["Header"] = "Academic performance";
    ViewData["SubHeader"] = PageTitleConstants.PrimarySchoolPageTitles.SubjectScaledScores;
    ViewData["Title"] = $"{Model.SchoolName} - Primary {ViewData["SubHeader"]}";
}

<div class="govuk-grid-row">
    @await Component.InvokeAsync("VerticalNavigation",
    new VerticalNavigationModel
    {
        URN = Model.URN,
        SchoolName = Model.SchoolName,
        ActivePage = RouteConstants.PrimaryAcademicPerformanceSubjectScaledScores,
        IsKS2 = Model.IsKS2,
        IsKS4 = Model.IsKS4,
        IsKS5 = Model.IsKS5
    })

    <div class="govuk-grid-column-three-quarters">
        <div id="guide-contents">
            <h2 class="govuk-heading-xl">@ViewData["Header"]</h2>

            @await Html.PartialAsync("_PrimaryPerformanceSubNavigation", (Model.RouteAttributes, PrimarySchoolPageTitles.SubjectScaledScores))

            <h2 class="govuk-heading-l">Scaled scores in reading and maths for the previous academic year</h2>

            <p class="govuk-body">
                Information in this section is for the 2024 to 2025 academic year.
            </p>

            <p class="govuk-body">
                These measures show pupils’ average scaled scores in reading and maths.
            </p>

            <p class="govuk-body">
                Pupils sit national tests in English reading and maths, typically when they are aged 10 or 11 and in year 6. The score they get on their test is converted into a scaled score.
            </p>

            <p class="govuk-body">
                The lowest scaled score a pupil can achieve is 80 and the highest is 120. When pupils achieve a scaled score of:
            </p>

            <ul class="govuk-list govuk-list--bullet">
                <li>100 or higher, they achieve the expected standard</li>
                <li>110 or higher, they achieve a higher standard</li>
            </ul>

            <div class="data-container">
                <h3 id="chartHeading" class="govuk-heading-m govuk-heading-m govuk-!-margin-top-3">
                    Average scaled score in reading
                </h3>


                <p class="govuk-body">
                    The lowest scaled score a pupil can achieve is 80 and the highest is 120. A scaled score of 100 is the expected standard.
                </p>
                  <p class="govuk-body">
                    Compare this school with state-funded local and national averages.
                </p>
                

                @await Component.InvokeAsync("ChartWithTableToggle", new ChartWithTableToggleModel
                {
                    IdPrefix = "read",
                    ChartPrefix = "read",
                    CurrentData = Model.AllReadData,
                    OverTimeData = Model.AllReadOverTimeData,
                    HasEstablishmentData = Model.HasReadEstablishmentData.IsAvailable,
                    IsScaled = true,
                    IsPercentageData = false,
                    ThreeYearAverageData = Model.ReadThreeYearAverageData
                })
            </div>

            <div class="data-container">
                <h3 id="chartHeading" class="govuk-heading-m govuk-heading-m govuk-!-margin-top-3">
                    Average scaled score in maths
                </h3>


                <p class="govuk-body">
                    The lowest scaled score a pupil can achieve is 80 and the highest is 120. A scaled score of 100 is the expected standard.
                </p>
                <p class="govuk-body">
                    Compare this school with state-funded local and national averages.
                </p>

                @await Component.InvokeAsync("ChartWithTableToggle", new ChartWithTableToggleModel
                {
                    IdPrefix = "maths",
                    ChartPrefix = "maths",
                    CurrentData = Model.AllMathsData,
                    OverTimeData = Model.AllMathsOverTimeData,
                    HasEstablishmentData = Model.HasMathsEstablishmentData.IsAvailable,
                    IsScaled = true,
                    IsPercentageData = false,
                    ThreeYearAverageData = Model.MathsThreeYearAverageData

                })
            </div>

            <govuk-accordion id="scaled-scores-by-pupil-characteristic-accordion" heading-level="3">
                <govuk-accordion-item expanded="false">
                    <govuk-accordion-item-heading>Average scaled scores in reading and maths by pupil characteristic</govuk-accordion-item-heading>
                    <govuk-accordion-item-content>
                        <h4 class="govuk-heading-m">Girls and boys</h4>
                        @await Html.PartialAsync("_AverageScaledScoresTable", Model.GirlsAndBoys, new ViewDataDictionary(ViewData) { { "id", "girls-boys-table" } })

                  
                        <h4 class="govuk-heading-m">English as an additional language (EAL)</h4>
                        <p class="govuk-body">
                            A child is recorded as having English as an additional language (EAL) if they hear or use a language other than
                            English at home. This does not show how well a child speaks English and does not mean they are new to the UK. 
                        </p>
                        @await Html.PartialAsync("_AverageScaledScoresTable", Model.EnglishAsAnAdditionalLanguage, new ViewDataDictionary(ViewData) { { "id", "eal-table" } })

                        <h4 class="govuk-heading-m">Non-mobile pupils</h4>
                        <p class="govuk-body">
                            Non‑mobile pupils are pupils who were at the same school throughout both year 5 and 6.
                        </p>
                        @await Html.PartialAsync("_AverageScaledScoresTable", Model.NonMobilePupils, new ViewDataDictionary(ViewData) { { "id", "nonmobile-pupils-table" } })

                        @await Html.PartialAsync("_DisadvantagedPupils")

                        @await Html.PartialAsync("_AverageScaledScoresTable", Model.DisadvantagedPupils, new ViewDataDictionary(ViewData) { { "id", "disadvantaged-pupils-table" } })


                        <details class="govuk-details" id="details-pupil-progress">
                            <summary class="govuk-details__summary">
                                <span class="govuk-details__summary-text">
                                    Compare with non-disadvantaged pupils
                                </span>
                            </summary>
                            <div class="govuk-details__text">
                                <h4 class="govuk-heading-m">Non-disadvantaged pupils</h4>
                                @await Html.PartialAsync("_AverageScaledScoresTable", Model.NonDisadvantagedPupils, new ViewDataDictionary(ViewData) { { "id", "non-disadvantaged-pupils-table" } })
                            </div>
                        </details>

                        @if (await FeatureManager.IsEnabledAsync(EnableKS2PupilCharacteristicDropdown))
                        {
                            <h4 class="govuk-heading-m">Prior attainment</h4>
                            <p class="govuk-body">
                                Pupils are grouped into low, middle and high prior attainers based on their results at the end of KS1.
                            </p>
                            <p class="govuk-body">
                                These figures show how each group performance at the end of KS2, helping you understand how well the school supports pupils with diffrent starting points. Pupils without KS1 results are not included.
                            </p>

                            <a class="govuk-link govuk-link--no-visited-state"
                               href="https://www.gov.uk/government/publications/primary-school-accountability/primary-school-accountability-in-2026-technical-guide#ks1-prior-attainment-groupings"
                               target="_blank"
                               rel="noreferrer noopener">

                                Find out more about prior attainment

                                <span class="govuk-visually-hidden">
                                    (opens in a new tab)
                                </span>
                            </a>

                            @await Html.PartialAsync("_AverageScaledScoresTable", Model.PriorAttainment, new ViewDataDictionary(ViewData) { { "id", "pa-table" } })
                        }
                        else
                        {
                            @await Html.PartialAsync("_LowMediumHighPriorAttainers")
                        }

                    </govuk-accordion-item-content>
                </govuk-accordion-item>
            </govuk-accordion>


            @await Component.InvokeAsync("SchoolProfilePagination", SchoolProfilePaginationModel.From(Model, RouteConstants.PrimaryAcademicPerformanceSubjectScaledScores))

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chart.umd.js"></script>
    <script src="~/js/chartjs-plugin-datalabels.min.js"></script>
    <script src="~/js/chart-factory.js"></script>
    <script src="~/js/chart-table-toggle.js"></script>
}
@model IEnumerable<PupilCharacteristicBaseViewModel>
@using SAPPub.Core.Enums
@using SAPPub.Web.Areas.Profiles.ViewModels.KS2
@using SAPPub.Web.Constants
@using SAPPub.Web.ViewComponents.VerticalNavigation
@using static SAPPub.Web.Constants.PageTitleConstants

@{
    ViewData["Header"] = "Academic performance";
    ViewData["SubHeader"] = Model.FirstOrDefault()?.Heading;
    ViewData["Title"] = $"{Model.FirstOrDefault()?.SchoolName} - Primary {ViewData["SubHeader"]}";
}

<div class="govuk-grid-row">
    @await Component.InvokeAsync("VerticalNavigation",
    new VerticalNavigationModel
    {
        URN = Model.FirstOrDefault()?.URN,
        SchoolName = Model.FirstOrDefault()?.SchoolName,
        ActivePage = RouteConstants.PrimaryPupilCharacteristicsGirlsAndBoys,
        IsKS2 = Model.FirstOrDefault().IsKS2,
        IsKS4 = Model.FirstOrDefault().IsKS4,
        IsKS5 = Model.FirstOrDefault().IsKS5
    })

    <div class="govuk-grid-column-three-quarters">
        <div id="guide-contents">
            <h2 class="govuk-heading-xl">@ViewData["Header"]</h2>

            @await Html.PartialAsync("_PrimaryPerformanceSubNavigation", (Model.FirstOrDefault()?.RouteAttributes, PrimarySchoolPageTitles.PupilProgress))

            @await Html.PartialAsync("_PupilCharacteristicDropdown", new PupilCharacteristicDropdownViewModel
            {
                SelectedPupilCharacteristic = (PupilCharacteristic)Model.FirstOrDefault()?.SelectedPupilCharacteristic,
                RouteAttributes = Model.FirstOrDefault()?.RouteAttributes
            })

            <h3 class="govuk-heading-l">@Model.FirstOrDefault()?.Heading</h3>

            <p class="govuk-body">This page is under construction.</p>
        </div>
    </div>
</div>

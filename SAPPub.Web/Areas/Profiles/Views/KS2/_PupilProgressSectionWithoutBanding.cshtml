@using SAPPub.Web.Areas.Profiles.ViewModels.KS2
@model PupilProgressSectionViewModel

@{
    var subjectId = Model.Subject.ToLowerInvariant();
}

<div class="data-container">
    <h4 class="govuk-heading-m govuk-!-margin-top-3">
        @Model.Subject
    </h4>

    <table id="@(subjectId)-progress-table" class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Comparison group</th>
                <th scope="col" class="govuk-table__header">Progress score</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">Disadvantaged pupils at @Model.SchoolName</td>
                <td class="govuk-table__cell">@Model.Score.DisplayNumber(format: "N1")</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Model.LocalAuthorityName</td>
                <td class="govuk-table__cell">@Model.LocalAuthorityScore.DisplayNumber(format: "N1")</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">England average</td>
                <td class="govuk-table__cell">@Model.EnglandScore.DisplayNumber(format: "N1")</td>
            </tr>
        </tbody>
    </table>
</div>

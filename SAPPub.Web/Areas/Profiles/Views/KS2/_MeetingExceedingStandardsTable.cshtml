@model SAPPub.Web.Areas.Profiles.ViewModels.Performance.MeetingExceedingStandardsViewModel

<table class="govuk-table" id="@ViewData["id"]">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header govuk-!-width-one-half">@Model.Column1Title</th>
            <th scope="col" class="govuk-table__header">Meeting the expected standard in reading, writing and maths</th>
            <th scope="col" class="govuk-table__header">Achieving at a higher standard in reading, writing and maths</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var row in Model.Rows)
        {
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">@row.RowTitle</th>
                <td class="govuk-table__cell">@row.MeetingStandard.DisplayPercentage()</td>
                <td class="govuk-table__cell">@row.ExceedingStandard.DisplayPercentage()</td>
            </tr>
        }
    </tbody>
</table>

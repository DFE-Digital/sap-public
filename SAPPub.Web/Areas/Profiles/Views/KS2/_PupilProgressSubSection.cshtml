@using SAPPub.Web.Areas.Profiles.ViewModels.KS2
@model (PupilProgressSectionViewModel PupilProgressSectionViewModel, string PupilGroup)

@{
    var subSection = Model.PupilProgressSectionViewModel;
    var tableId = $"{subSection.Subject}-{Model.PupilGroup}-progress-table".ToLowerInvariant();
}

<h5 class="govuk-heading-s">@Model.PupilGroup</h5>

<table id="@tableId" class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Comparison group</th>
            <th scope="col" class="govuk-table__header">Progress score</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">@Model.PupilGroup at @subSection.SchoolName</td>
            <td class="govuk-table__cell">@subSection.Score.DisplayNumber(format: "N1")</td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">@subSection.LocalAuthorityName</td>
            <td class="govuk-table__cell">@subSection.LocalAuthorityScore.DisplayNumber(format: "N1")</td>
        </tr>

        <tr class="govuk-table__row">
            <td class="govuk-table__cell">England average</td>
            <td class="govuk-table__cell">@subSection.EnglandScore.DisplayNumber()</td>
        </tr>
    </tbody>
</table>

@model SAPPub.Web.Areas.Profiles.ViewModels.KS2.AcademicPerformanceAdditionalMeasuresViewModel
@using SAPPub.Web.Constants
@using SAPPub.Web.ViewComponents.SchoolProfilePagination
@using SAPPub.Web.ViewComponents.VerticalNavigation
@using static SAPPub.Web.Constants.PageTitleConstants

@{
    ViewData["Header"] = "Academic performance";
    ViewData["SubHeader"] = PageTitleConstants.PrimarySchoolPageTitles.AdditionalMeasures;
    ViewData["Title"] = $"{Model.SchoolName} - Primary {ViewData["SubHeader"]}";
}

<div class="govuk-grid-row">
    @await Component.InvokeAsync("VerticalNavigation",
    new VerticalNavigationModel
    {
        URN = Model.URN,
        SchoolName = Model.SchoolName,
        ActivePage = RouteConstants.PrimaryAcademicPerformanceAdditionalMeasures,
        IsKS2 = Model.IsKS2,
        IsKS4 = Model.IsKS4,
        IsKS5 = Model.IsKS5
    })

    <div class="govuk-grid-column-three-quarters">
        <h2 class="govuk-heading-xl">@ViewData["Header"]</h2>
        <p class="govuk-body">
            Looking at school performance data is one way to see how well a school is doing.
            You should look at a range of information about a school before deciding if it’s the right fit for your child.
        </p>

        <nav id="sub-navigation-academic-performance" class="moj-sub-navigation" aria-label="Sub navigation">
            <ul class="moj-sub-navigation__list">
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.PrimaryAcademicPerformancePupilProgress" asp-all-route-data="@Model.RouteAttributes">@PrimarySchoolPageTitles.PupilProgress</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.PrimaryAcademicPerformanceMeetingOrExceedingStandards" asp-all-route-data="@Model.RouteAttributes">@PrimarySchoolPageTitles.MeetingOrExceedingStandards</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.PrimaryAcademicPerformanceSubjectScaledScores" asp-all-route-data="@Model.RouteAttributes">@PrimarySchoolPageTitles.SubjectScaledScores</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" aria-current="page" asp-route="@RouteConstants.PrimaryAcademicPerformanceAdditionalMeasures" asp-all-route-data="@Model.RouteAttributes">@PrimarySchoolPageTitles.AdditionalMeasures</a>
                </li>
            </ul>
        </nav>

        <h2 class="govuk-heading-l">@PrimarySchoolPageTitles.AdditionalMeasures</h2>

        <p class="govuk-body">
            Information in this section is for the @Model.CurrentYear academic year.
        </p>

        <p class="govuk-body">
            Compare additional performance measures for this school with local council and national performance.
        </p>

        <details class="govuk-details" id="details-additional-measures">
            <summary class="govuk-details__summary">
                <span class="govuk-details__summary-text">
                    Find out more about the additional measures
                </span>
            </summary>
            <div class="govuk-details__text">
                <govuk-details-summary>
                    <h3 class="govuk-heading-s">Additional measures</h3>
                </govuk-details-summary>
                <govuk-details-text>
                    <p class="govuk-body">
                        These measures show the percentage of pupils achieving the expected or higher standard based on assessments at
                        the end of key stage 2 typically when they are aged 10 or 11 and in year 6.
                    </p>
                </govuk-details-text>
                <govuk-details-summary>
                    <h3 class="govuk-heading-s">Grammar, punctuation, spelling at the expected standard</h3>
                </govuk-details-summary>
                <govuk-details-text>
                    <p class="govuk-body">
                        Pupils achieve the expected standard when they achieve a scaled score of 100 or higher in grammar, punctuation and spelling.
                    </p>
                </govuk-details-text>
                <govuk-details-summary>
                    <h3 class="govuk-heading-s">Grammar, punctuation, spelling at the higher standard</h3>
                </govuk-details-summary>
                <govuk-details-text>
                    <p class="govuk-body">
                        Pupils achieve the expected standard when they achieve a scaled score of 110 or higher in grammar, punctuation and spelling.
                    </p>
                </govuk-details-text>
            </div>

        </details>

        <table id="additional-measures-breakdown-table" class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header govuk-!-width-one-third">Pupil group</th>
                    <th scope="col" class="govuk-table__header">Grammar, punctuation, spelling at the expected standard</th>
                    <th scope="col" class="govuk-table__header">Grammar, punctuation, spelling at the higher standard</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">School</th>
                    <td class="govuk-table__cell">@Model.EstablishmentGrammarAtExpectedStandard.DisplayPercentage()</td>
                    <td class="govuk-table__cell">@Model.EstablishmentGrammarAtHigherStandard.DisplayPercentage()</td>
                </tr>
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">@Model.LAName average</th>
                    <td class="govuk-table__cell">@Model.LAGrammarAtExpectedStandard.DisplayPercentage()</td>
                    <td class="govuk-table__cell">@Model.LAGrammarAtHigherStandard.DisplayPercentage()</td>
                </tr>
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">England average</th>
                    <td class="govuk-table__cell">@Model.EnglandGrammarAtExpectedStandard.DisplayPercentage()</td>
                    <td class="govuk-table__cell">@Model.EnglandGrammarAtHigherStandard.DisplayPercentage()</td>
                </tr>
            </tbody>
        </table>


        <h2 class="govuk-heading-l govuk-!-margin-top-9">Number of pupils at the end of key stage 2</h2>
            <table id="pupils-eoks2-table" class="govuk-table">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">Pupil group</th>
                        <th scope="col" class="govuk-table__header">School</th>
                        <th scope="col" class="govuk-table__header">@Model.LAName</th>
                        <th scope="col" class="govuk-table__header">England</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">Number of pupils at the end of KS2</th>
                        <td class="govuk-table__cell">@Model.EstablishmentNumPupilsEndOfKS2.DisplayNumber()</td>
                        <td class="govuk-table__cell">@Model.LANumPupilsEndOfKS2.DisplayNumber()</td>
                        <td class="govuk-table__cell">@Model.EnglandNumPupilsEndOfKS2.DisplayNumber()</td>
                    </tr>
                </tbody>
            </table>

        <govuk-accordion id="pupil-population-accordion-by-characteristics" heading-level="3">
            <govuk-accordion-item expanded="false">
                <govuk-accordion-item-heading>Further population data for ends of KS2</govuk-accordion-item-heading>
                <govuk-accordion-item-content>
                    <section id="pupils-by-characteristics">
                        <h4 class="govuk-heading-m">Number of Pupils by characteristics</h4>

                        <p class="govuk-body">
                            Compare the number of pupils by characteristics at this school or college, with pupils at state‑funded school locally and across England.
                        </p>

                        <govuk-details id="details-pupil-characteristics-explained">
                            <govuk-details-summary>
                                More information about the pupil characteristics
                            </govuk-details-summary>
                            <govuk-details-text>
                                <h4>English as an additional language (EAL)</h4>
                                <p class="govuk-body">
                                    A child is recorded as having English as an additional language (EAL) if they hear or use a language other than English at home. 
                                    This does not show how well a child speaks English and does not mean they are new to the UK.
                                </p>

                                <h4>Non-mobile pupils</h4>
                                <p class="govuk-body">
                                    Non-mobile pupils are pupils who were at the school throughout both year 5 and year 6.
                                </p>

                                <h4>Disadvantaged pupils </h4>
                                <p class="govuk-body">
                                    Pupils identified as disadvantaged are those who either:
                                 

                                </p>
                                <ul class="govuk-list govuk-list--bullet">
                                    <li>were eligible for free school meals at any time during the last 6 years</li>
                                    <li>have been in the care of the local council for a day or more</li>
                                    <li>have been adopted from care</li>
                                </ul>

                            </govuk-details-text>
                        </govuk-details>

                        <table id="ks2-population-breakdown-table" class="govuk-table">
                            <thead class="govuk-table__head">
                                <tr class="govuk-table__row">
                                    <th scope="col" class="govuk-table__header"></th>
                                    <th scope="col" class="govuk-table__header">School</th>
                                </tr>
                            </thead>
                            <tbody class="govuk-table__body">
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">Girls</th>
                                    <td class="govuk-table__cell">@Model.EstablishmentNumGirlsEndOfKS2.DisplayNumber()</td>
                                </tr>
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">Boys</th>
                                    <td class="govuk-table__cell">@Model.EstablishmentNumBoysEndOfKS2.DisplayNumber()</td>
                                </tr>
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">English as an additional language (EAL)</th>
                                    <td class="govuk-table__cell">@Model.EstablishmentNumEALEndOfKS2.DisplayNumber()</td>
                                </tr>
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">Non-mobile pupils</th>
                                    <td class="govuk-table__cell">@Model.EstablishmentNumNonMobileEndOfKS2.DisplayNumber()</td>
                                </tr>

                            </tbody>
                        </table>
                    </section>
                    <section id="disadvantaged-pupils-section">
                        <h4 class="govuk-heading-m">Disadvantaged pupils</h4>
                        <table id="disadvantaged-pupils-population-table" class="govuk-table">
                            <thead class="govuk-table__head">
                                <tr class="govuk-table__row">
                                    <th scope="col" class="govuk-table__header"></th>
                                    <th scope="col" class="govuk-table__header">School</th>
                                    <th scope="col" class="govuk-table__header">@Model.LAName</th>
                                    <th scope="col" class="govuk-table__header">England</th>
                                </tr>
                            </thead>
                            <tbody class="govuk-table__body">
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">Number of disadvantaged pupils</th>
                                    <td class="govuk-table__cell">@Model.EstablishmentNumDisadvantagedEndOfKS2.DisplayNumber()</td>
                                    <td class="govuk-table__cell">@Model.LANumDisadvantagedEndOfKS2.DisplayNumber()</td>
                                    <td class="govuk-table__cell">@Model.EnglandNumDisadvantagedEndOfKS2.DisplayNumber()</td>
                                </tr>
                            </tbody>
                        </table>
                    </section>

                    <govuk-details id="details-compare-non-disadvantaged-pupils-explained">
                        <govuk-details-summary>
                            Compare with non-disadvantaged pupils
                        </govuk-details-summary>
                        <govuk-details-text>
                            <h4>Non-disadvantaged pupils</h4>
                            <table id="non-disadvantaged-pupils-compare-table" class="govuk-table">
                                <thead class="govuk-table__head">
                                    <tr class="govuk-table__row">
                                        <th scope="col" class="govuk-table__header"></th>
                                        <th scope="col" class="govuk-table__header">@Model.LAName</th>
                                        <th scope="col" class="govuk-table__header">England</th>
                                    </tr>
                                </thead>
                                <tbody class="govuk-table__body">
                                    <tr class="govuk-table__row">
                                        <th scope="row" class="govuk-table__header">Number of non-disadvantaged pupils</th>
                                        <td class="govuk-table__cell">@Model.LANumNonDisadvantagedEndOfKS2.DisplayNumber()</td>
                                        <td class="govuk-table__cell">@Model.EnglandNumNonDisadvantagedEndOfKS2.DisplayNumber()</td>
                                    </tr>
                                </tbody>
                            </table>

                        </govuk-details-text>
                    </govuk-details>

                </govuk-accordion-item-content>
            </govuk-accordion-item>
        </govuk-accordion>


        <h2 class="govuk-heading-l  govuk-!-margin-top-9">Number of pupils at the whole school</h2>
        <table id="whole-school-population-table" class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Pupil group</th>
                    <th scope="col" class="govuk-table__header">School</th>
                    <th scope="col" class="govuk-table__header">England mainstream schools</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">Number of pupils on roll</th>
                    <td class="govuk-table__cell">@Model.EstablishmentNumberOfPupils.DisplayText()</td>
                    <td class="govuk-table__cell">@Model.EnglandNumberOfPupils.DisplayNumber()</td>
                </tr>
            </tbody>
        </table>


        <govuk-accordion id="pupil-population-accordion" heading-level="3">
            <govuk-accordion-item expanded="false">
                <govuk-accordion-item-heading>Further population data for the whole school</govuk-accordion-item-heading>
                <govuk-accordion-item-content>
                    <section id="pupils-with-sen-support-section">
                        <h4 class="govuk-heading-m">Pupils with Special Educational Needs (SEN) support</h4>
                        <p class="govuk-body">
                            Pupils with special educational needs who receive extra support than other children of the same age in school but do not have an EHCP.
                        </p>
                        <table id="sen-population-table" class="govuk-table">
                            <thead class="govuk-table__head">
                                <tr class="govuk-table__row">
                                    <th scope="col" class="govuk-table__header govuk-!-width-one-half"></th>
                                    <th scope="col" class="govuk-table__header govuk-!-width-one-quarter">School</th>
                                    <th scope="col" class="govuk-table__header">England mainstream schools</th>
                                </tr>
                            </thead>
                            <tbody class="govuk-table__body">
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">Pupils with SEN support</th>
                                    <td class="govuk-table__cell">@Model.EstablishmentSENSupportPopulation.DisplayPercentage()</td>
                                    <td class="govuk-table__cell">@Model.EnglandSENSupportPopulation.DisplayPercentage()</td>
                                </tr>
                            </tbody>
                        </table>
                    </section>
                    <section id="pupils-with-ehcp-section">
                        <h4 class="govuk-heading-m">Pupils with an Education, Health and Care Plan (EHCP)</h4>
                        <p class="govuk-body">
                            An EHCP is a legal document for children and young people aged up to 25 who need more support than is available through special educational needs (SEN) support.  
                        </p>
                        <p class="govuk-body">
                            EHCPs identify educational, health and social care needs and set out the additional support to meet those needs.  
                        </p>
                        <table id="ehcp-population-table" class="govuk-table">
                            <thead class="govuk-table__head">
                                <tr class="govuk-table__row">
                                    <th scope="col" class="govuk-table__header govuk-!-width-one-half"></th>
                                    <th scope="col" class="govuk-table__header govuk-!-width-one-quarter">School</th>
                                    <th scope="col" class="govuk-table__header">England mainstream schools</th>
                                </tr>
                            </thead>
                            <tbody class="govuk-table__body">
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">Pupils with EHCPs</th>
                                    <td class="govuk-table__cell">@Model.EstablishmentEHCPPopulation.DisplayPercentage()</td>
                                    <td class="govuk-table__cell">@Model.EnglandEHCPPopulation.DisplayPercentage()</td>
                                </tr>
                            </tbody>
                        </table>
                    </section>

                </govuk-accordion-item-content>
            </govuk-accordion-item>
        </govuk-accordion>

        @await Component.InvokeAsync("SchoolProfilePagination", SchoolProfilePaginationModel.From(Model, RouteConstants.PrimaryAcademicPerformanceAdditionalMeasures))

    </div>
</div>
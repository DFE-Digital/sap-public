@model AcademicPerformancePupilProgressViewModel;
@using SAPPub.Web.Areas.Profiles.ViewModels.KS2
@using SAPPub.Web.Constants
@using SAPPub.Web.ViewComponents.SchoolProfilePagination
@using SAPPub.Web.ViewComponents.VerticalNavigation
@using static SAPPub.Web.Constants.PageTitleConstants

@{
    ViewData["Header"] = "Academic performance";
    ViewData["SubHeader"] = PageTitleConstants.PrimarySchoolPageTitles.PupilProgress;
    ViewData["Title"] = $"{Model.SchoolName} - Primary {ViewData["SubHeader"]}";
}

<div class="govuk-grid-row">
    @await Component.InvokeAsync("VerticalNavigation",
    new VerticalNavigationModel
    {
        URN = Model.URN,
        SchoolName = Model.SchoolName,
        ActivePage = RouteConstants.PrimaryAcademicPerformancePupilProgress,
        IsKS2 = Model.IsKS2,
        IsKS4 = Model.IsKS4,
        IsKS5 = Model.IsKS5
    })

    <div class="govuk-grid-column-three-quarters">
        <h2 class="govuk-heading-xl">@ViewData["Header"]</h2>
        <p class="govuk-body">
            Looking at school performance data is one way to see how well a school is doing.
            You should look at a range of information about a school before deciding if it’s the right fit for your child.
        </p>
        <nav id="sub-navigation-academic-performance" class="moj-sub-navigation" aria-label="Sub navigation">
            <ul class="moj-sub-navigation__list">
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" aria-current="page" asp-route="@RouteConstants.PrimaryAcademicPerformancePupilProgress" asp-all-route-data="@Model.RouteAttributes">@PrimarySchoolPageTitles.PupilProgress</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.PrimaryAcademicPerformanceMeetingOrExceedingStandards" asp-all-route-data="@Model.RouteAttributes">@PrimarySchoolPageTitles.MeetingOrExceedingStandards</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.PrimaryAcademicPerformanceSubjectScaledScores" asp-all-route-data="@Model.RouteAttributes">@PrimarySchoolPageTitles.SubjectScaledScores</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.PrimaryAcademicPerformanceAdditionalMeasures" asp-all-route-data="@Model.RouteAttributes">@PrimarySchoolPageTitles.AdditionalMeasures</a>
                </li>
            </ul>
        </nav>
        <h2 class="govuk-heading-l">Progress scores in reading, writing and maths</h2>
        <form method="get" asp-route="@RouteConstants.PrimaryAcademicPerformancePupilProgress" asp-all-route-data="@Model.RouteAttributes">
            <div id="filterSection" class="select-filter">
                <label for="academicYearSelector" class="govuk-label govuk-!-font-weight-bold">Choose the academic year you want to see results for</label>
                <select id="academicYearSelector" class="govuk-select" asp-for="SelectedAcademicYear" asp-items="Model.AcademicYearsSelectList"></select>
                <govuk-button type="submit">Show results</govuk-button>
            </div>
        </form>

        <p class="govuk-body" id="academic-year-info">@Model.AcademicYearInfoParagraph</p>

        <p class="govuk-body">
            Progress scores in reading, writing, and maths show how much progress pupils have made between the end of key stage 1 (KS1) and the end of key stage 2 (KS2), compared to other pupils across England who had similar starting points.
        </p>
        <p class="govuk-body">
            These scores help show how well a school supports all pupils in making progress during their time in primary school.
        </p>
        <p class="govuk-body">
            The score shows progress compared to the national average:
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>A score of zero means pupils made about the same progress as similar pupils across England.</li>
            <li>A positive score means pupils made more progress than similar pupils across England.</li>
            <li>A negative score means pupils made less progress than similar pupils across England.</li>
        </ul>


        @if (Model.ShowDataNotAvailableInfo)
        {
            <div class="custom-card" id="data-not-available-custom-card">
                <div class="info__icon"></div>
                <div class="custom-card__content">
                    <p class="govuk-body">
                        There are no Progress scores available for reading, writing and maths for the academic years 2023 to 2024 and 2024 to 2025.
                        This is because there is no KS1 baseline available to calculate progress measures for these years due to COVID-19 disruption.
                    </p>
                </div>
            </div>
        }
        else if (!Model.ShowReadingScore && !Model.ShowMathsScore && !Model.ShowWritingScore)
        {
            @await Html.PartialAsync("_NoProgressData", "nodata")
        }

        else
        {
            
        <govuk-details id="details-pupil-progress">
            <govuk-details-summary>
                Find out more about progress scores and confidence intervals
            </govuk-details-summary>
            <govuk-details-text>
                <p class="govuk-body">
                    Progress scores are influenced by both the school and their pupils. It is difficult to determine how much of the progress score is due to the school and how much is due to the pupils themselves. Confidence intervals reflect this uncertainty.
                </p>
                <p class="govuk-body">
                    If the confidence intervals for two schools overlap, it means we cannot be sure that one school’s progress score is better than the other.
                </p>
                <p class="govuk-body">
                    The greater the number of pupils, the smaller the range of the confidence interval. Smaller schools have larger confidence intervals because fewer pupils are included, so the score is more affected by the performance of individual pupils.
                </p>
                <p class="govuk-body">
                    A school is above average if its progress score is above 0 and the entire confidence interval is above 0.
                </p>
                <p class="govuk-body">
                    A school is below average if its progress score is below 0 and the entire confidence interval is below 0.
                </p>
                <p class="govuk-body">
                    Read more about how confidence intervals are used in the
                    <a class="govuk-link govuk-link--no-visited-state" href="@Model.PrimarySchoolAccountabilityLinkUrl" rel="nofollow noreferrer" target="@(Model.PrimarySchoolAccountabilityLinkNewTab ? "_blank" : "_self")">
                        primary accountability measures guidance <span class="govuk-visually-hidden">(opens in a new tab)</span>
                    </a>.
                </p>
            </govuk-details-text>
        </govuk-details>

            <div id="reading-information">
                <h3 class="govuk-heading-m">Reading</h3>
                @if (!Model.ShowReadingScore)
                {
                    @await Html.PartialAsync("_NoProgressData", "reading")
                }
                else
                {
                    <div class="custom-card" id="reading-establishment-card">
                        <div class="assignment__icon"></div>
                        <div class="custom-card__content">
                            <p class="govuk-body">
                                Pupils at this school score @Model.EstablishmentReadingScore.Score.
                                @if (Model.EstablishmentReadingScore.BandingRating.HasValue)
                                {
                                    @Model.EstablishmentReadingScore.BandingRating.ToBandingString().DisplayText()
                                }
                            </p>
                            <p class="govuk-body">
                                The confidence interval is @Model.EstablishmentReadingScore.ConfidenceLevelLower to @Model.EstablishmentReadingScore.ConfidenceLevelUpper
                            </p>
                        </div>
                    </div>


                    <div class="custom-card" id="reading-localauthority-card">
                        <div class="custom-card__content">
                            <p class="govuk-body">
                                The local authority average is @Model.LaReadingAverage
                            </p>
                        </div>
                        <div class="bar-chart__icon"></div>
                    </div>
                }

            </div>

            <div id="writing-information">
                <h3 class="govuk-heading-m">Writing</h3>

                @if (!Model.ShowWritingScore)
                {
                    @await Html.PartialAsync("_NoProgressData", "writing")
                }
                else
                {
                    <div class="custom-card" id="writing-establishment-card">
                        <div class="assignment__icon"></div>
                        <div class="custom-card__content">
                            <p class="govuk-body">
                                Pupils at this school score @Model.EstablishmentWritingScore.Score.
                                @if (Model.EstablishmentWritingScore.BandingRating.HasValue)
                                {
                                    @Model.EstablishmentWritingScore.BandingRating.ToBandingString().DisplayText()
                                }
                            </p>
                            <p class="govuk-body">
                                The confidence interval is @Model.EstablishmentWritingScore.ConfidenceLevelLower to @Model.EstablishmentWritingScore.ConfidenceLevelUpper
                            </p>
                        </div>
                    </div>
                    <div class="custom-card" id="writing-localauthority-card">
                        <div class="custom-card__content">
                            <p class="govuk-body">
                                The local authority average is @Model.LaWritingAverage
                            </p>
                        </div>
                        <div class="bar-chart__icon"></div>
                    </div>
                }

          
            </div>

            <div id="maths-information">
                <h3 class="govuk-heading-m">Maths</h3>

                @if (!Model.ShowMathsScore)
                {
                    @await Html.PartialAsync("_NoProgressData", "maths")
                }
                else
                {
                    <div class="custom-card" id="maths-establishment-card">
                        <div class="assignment__icon"></div>
                        <div class="custom-card__content">
                            <p class="govuk-body">
                                Pupils at this school score @Model.EstablishmentMathsScore.Score.
                                @if (Model.EstablishmentMathsScore.BandingRating.HasValue)
                                {
                                    @Model.EstablishmentMathsScore.BandingRating.ToBandingString().DisplayText()
                                }
                            </p>
                            <p class="govuk-body">
                                The confidence interval is @Model.EstablishmentMathsScore.ConfidenceLevelLower to @Model.EstablishmentMathsScore.ConfidenceLevelUpper
                            </p>
                        </div>
                    </div>

                    <div class="custom-card" id="maths-localauthority-card">
                        <div class="custom-card__content">
                            <p class="govuk-body">
                                The local authority average is @Model.LaMathsAverage
                            </p>
                        </div>
                        <div class="bar-chart__icon"></div>
                    </div>

                }

            </div>
        }
        @await Component.InvokeAsync("SchoolProfilePagination", SchoolProfilePaginationModel.From(Model, RouteConstants.PrimaryAcademicPerformancePupilProgress))

    </div>
</div>

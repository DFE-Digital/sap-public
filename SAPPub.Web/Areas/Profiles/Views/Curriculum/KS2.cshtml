@model CurriculumAndExtraCurricularActivitiesViewModel;
@using SAPPub.Web.Areas.Profiles.ViewModels.KS2
@using SAPPub.Web.Constants
@using SAPPub.Web.ViewComponents.SchoolProfilePagination
@using SAPPub.Web.ViewComponents.VerticalNavigation

@{
    ViewData["Header"] = "Curriculum and extra-curricular activities";
    ViewData["SubHeader"] = PageTitleConstants.PrimarySchoolPageTitles.Curriculum;
    ViewData["Title"] = $"{Model.SchoolName} - {ViewData["SubHeader"]}";
}

<div class="govuk-grid-row">
    @await Component.InvokeAsync("VerticalNavigation",
    new VerticalNavigationModel
    {
        URN = Model.URN,
        SchoolName = Model.SchoolName,
        ActivePage = RouteConstants.CurriculumRoot,
        IsKS2 = Model.IsKS2,
        IsKS4 = Model.IsKS4,
        IsKS5 = Model.IsKS5
    })

    <div class="govuk-grid-column-three-quarters">
        <h2 class="govuk-heading-xl">@ViewData["Header"]</h2>
        @if (Model.IsKS4 == true)
        {
            <nav id="sub-navigation-academic-performance" class="moj-sub-navigation" aria-label="Sub navigation">
                <ul class="moj-sub-navigation__list">
                    <li class="moj-sub-navigation__item">
                        <a class="moj-sub-navigation__link" aria-current="page" asp-route="@RouteConstants.PrimaryCurriculumAndExtraCurricularActivities" asp-all-route-data="@Model.RouteAttributes">@PageTitleConstants.PrimarySchoolPageTitles.Curriculum</a>
                    </li>
                    <li class="moj-sub-navigation__item">
                        <a class="moj-sub-navigation__link" asp-route="@RouteConstants.SecondaryCurriculumAndExtraCurricularActivities" asp-all-route-data="@Model.RouteAttributes">@PageTitleConstants.SecondarySchoolPageTitles.Curriculum</a>
                    </li>
                </ul>
            </nav>
        }
        <h2 class="govuk-heading-l">Curriculum</h2>
        <div id="current-curriculum-summary" data-testId="current-curriculum-summary" class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h3 class="govuk-summary-card__title">Current curriculum</h3>
            </div>
            <div class="govuk-summary-card__content">
                <div class="govuk-summary-list__row">
                    <p class="govuk-body">
                        Primary schools that teach Reception, ages 4 to 5, follow the Early Years Foundation Stage (EYFS) framework. This focuses on areas such as communication, literacy maths and personal development.
                    </p>
                    <p class="govuk-body">
                        Year 1 to year 6, ages 5 to 11, children in all local-authority-maintained schools follow the national curriculum, studying subjects including English, maths, science, history and geography.
                    </p>
                    <p class="govuk-body">
                        Academies must teach a broad and balanced curriculum including English, maths and science, and all schools may decide how the curriculum is taught and provide additional topics.
                    </p>
                    <p class="govuk-body">
                        The national curriculum at primary includes swimming, sport and music lessons, but some schools may offer further clubs or sessions in these subjects.
                    </p>
                </div>
                @if (Model.SchoolWebsite.IsAvailable)
                {
                    <govuk-summary-list>
                        <govuk-summary-list-row>
                            <govuk-summary-list-row-key>
                                Primary school curriculum
                            </govuk-summary-list-row-key>
                            <govuk-summary-list-row-value>

                                <a class="govuk-link" rel="noreferrer noopener" target="_blank" href="@Model.SchoolWebsite.DisplayText(UrlHelper.EnsureHttpsUrl)">
                                    View the school's curriculum on their website
                                    <span class="govuk-visually-hidden">(opens in a new tab)</span>
                                </a>


                            </govuk-summary-list-row-value>
                        </govuk-summary-list-row>
                    </govuk-summary-list>
                }
                else
                {
                    <p data-testId="contact-school-info-ks2">Contact the school for more information.</p>
                }
            </div>
        </div>

        <h2 class="govuk-heading-l govuk-!-margin-top-5">
            Extra-curricular activities
        </h2>

        <h3 class="govuk-heading-m">
            Activities schools can offer
        </h3>

        <p class="govuk-body">
            Schools can offer a range of extra-curricular activities, such as:
        </p>

        <ul class="govuk-list govuk-list--bullet">
            <li>
                civic engagement, for example volunteering, debating, school democracy, community engagement
            </li>
            <li>
                arts and culture, for example, taking part in and having live experience of music, art, dance, theatre, other expressive arts, visits to museums and galleries
            </li>
            <li>
                nature, outdoors and adventure, for example time outdoors, climate education and sustainability projects, gardening, residentials and camps
            </li>
            <li>
                sport and physical activities, for example participating in individual and team sports, physical activities like dance, fitness activities or cycling, representing the school, attending live events
            </li>
            <li>
                developing wider life and future skills, for example digital literacy, STEM clubs, cooking, managing finances, enterprise
            </li>
        </ul>

        <div id="current-extra-curricular-activities-offered-summary" class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h3 class="govuk-summary-card__title">Current extra-curricular activities offered</h3>
            </div>
            <div class="govuk-summary-card__content">
                <div class="govuk-summary-list__row">
                    <p class="govuk-body">
                        Most schools offer a range of activities that are linked to, or work in addition to, the curriculum.
                    </p>
                    <p class="govuk-body">
                        The range of activities can vary due to staff availability, time of year and funding.
                    </p>
                </div>
                 @if (Model.SchoolWebsite.IsAvailable)
                            {
                <govuk-summary-list>
                    <govuk-summary-list-row>
                        <govuk-summary-list-row-key>Extra-curricular activities</govuk-summary-list-row-key>
                        <govuk-summary-list-row-value>
                           
                                <a class="govuk-link" rel="noreferrer noopener" target="_blank" href="@Model.SchoolWebsite.DisplayText(UrlHelper.EnsureHttpsUrl)">
                                    Visit the school website for current extra-curricular activities
                                    <span class="govuk-visually-hidden">(opens in a new tab)</span>
                                </a>
                           
                        </govuk-summary-list-row-value>
                    </govuk-summary-list-row>
                </govuk-summary-list>
                }
                else
                {
                    <p data-testId="contact-school-info-extra">Contact the school for more information.</p>
                }
            </div>
        </div>

        @await Component.InvokeAsync("SchoolProfilePagination", SchoolProfilePaginationModel.From(Model, RouteConstants.PrimaryCurriculumAndExtraCurricularActivities))

    </div>
</div>
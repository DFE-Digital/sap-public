@using SAPPub.Core.Enums.KS5Qualifications
@model SAPPub.Web.Areas.Profiles.ViewModels.KS5.AverageResultViewModel

@if (Model is null)
{
    return;
}

@{
    var qualification = ViewData["QualificationLevel"];
    var laName = ViewData["LAName"];
}

<h3 class="govuk-heading-m">Average result</h3>

@if (qualification is Level3 level3Qualification)
{
    if (level3Qualification == Level3.AppliedGeneral)
    {
        <p class="govuk-body">
            This shows the average grade and points per @level3Qualification.GetDisplayName() entry.
        </p>

        <p class="govuk-body">
            We use points to compare different qualifications fairly, even if they have different sizes
            or grading systems. We base the number of points on the challenge and size of a qualification.
        </p>

        <p class="govuk-body">
            A maximum of 50 points are available for a top grade in applied general qualifications which take
            the same amount of time to study as an A level.
        </p>
    }
    else if (level3Qualification == Level3.TechLevel)
    {
        <p class="govuk-body">
            This shows the average grade and points students achieved in their tech levels.
        </p>

        <p class="govuk-body">
            We use points to compare different qualifications fairly, even if they have different sizes
            or grading systems.
        </p>

        <p class="govuk-body">
            For example, a maximum of 50 points are available for a top grade in tech levels which take
            the same amount of study as an A level.
        </p>

        <p class="govuk-body">
            T level performance measures are not yet included here. Find out more details in the
            <a id="measures-tech-guidance-link"
               class="govuk-link"
               rel="noreferrer noopener"
               target="_blank"
               href="https://www.gov.uk/government/publications/16-to-19-accountability-headline-measures-technical-guide">
                16 to 19 technical guide <span class="govuk-visually-hidden">(opens in a new tab)</span>
            </a>
            and
            <a id="intro-t-levels-link"
               class="govuk-link"
               rel="noreferrer noopener"
               target="_blank"
               href="https://www.gov.uk/government/publications/introduction-of-t-levels/introduction-of-t-levels">
                introduction of T levels <span class="govuk-visually-hidden">(opens in a new tab)</span>
            </a>
        </p>
    }
    else
    {
        <p class="govuk-body">
            This shows the average grade and points per @level3Qualification.GetDisplayName() entry.
        </p>

        <p class="govuk-body">
            We use points to compare different qualifications fairly, even if they have different sizes or grading systems.
            For example, an A* at A level is worth up to 60 points.
        </p>
    }

    <p class="govuk-body">
        Compare this school or college with state-funded local and national averages.
    </p>

    <p class="govuk-body">
        <a id="performance-points-link" class="govuk-link" rel="noreferrer noopener" target="_blank" href="https://www.gov.uk/government/publications/performance-points-a-practical-guide-to-key-stage-4-and-5-points">
            Find out how performance points work <span class="govuk-visually-hidden">(opens in a new tab)</span>
        </a>
    </p>
}
else if (qualification is Level2 level2Qualification)
{
    if (level2Qualification == Level2.TechCert)
    {
        <p class="govuk-body">
            This shows the average grade and points students achieved in their technical certificates.
        </p>

        <p class="govuk-body">
            A points system is used to make different qualifications easier to compare. Each qualification gets
            a points value based on how challenging it is and how big it is. Level 2 and level 3 qualifications
            use different points scales, so you cannot compare them directly.
        </p>

        <p class="govuk-body">
            Compare this school or college with state-funded local and national averages.
        </p>

        <p class="govuk-body">
            <a id="performance-points-link" class="govuk-link" rel="noreferrer noopener" target="_blank" href="https://www.gov.uk/government/publications/performance-points-a-practical-guide-to-key-stage-4-and-5-points">
                Find out how performance points work <span class="govuk-visually-hidden">(opens in a new tab)</span>
            </a>
        </p>
    }
}

@if (qualification is Level3.ALevel ||
     qualification is Level3.Academic ||
     qualification is Level3.AppliedGeneral ||
     qualification is Level3.TechLevel)
{
    const string averageResultIdPrefix = "average-result";
    var showAverageResultOverTime = DataViewToggleHelper.IsOverTimeView(Context.Request, averageResultIdPrefix);

    <div class="data-container">

        
        <div id="@DataViewToggleHelper.AnchorId(averageResultIdPrefix)"
             class="chart-table-toggle"
             data-id-prefix="@averageResultIdPrefix"
             data-view="@(showAverageResultOverTime ? DataViewToggleHelper.OverTimeView : DataViewToggleHelper.CurrentView)">

            <div id="average-result-current-year-table-container" data-view-panel="@DataViewToggleHelper.CurrentView" hidden="@showAverageResultOverTime">

                <a id="average-result-show-data-over-time-btn"
                   href="@DataViewToggleHelper.ViewUrl(Context.Request, averageResultIdPrefix, overTime: true)"
                   role="button"
                   draggable="false"
                   class="govuk-button govuk-button--secondary govuk-!-margin-top-3 govuk-!-margin-bottom-0"
                   data-module="govuk-button"
                   data-show-view="@DataViewToggleHelper.OverTimeView">Show data over time</a>

                <table id="average-result-current-year-table" class="govuk-table">
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header"></th>
                            <th scope="col" class="govuk-table__header">Grade</th>
                            <th scope="col" class="govuk-table__header">Points</th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">School or college</th>
                            <td class="govuk-table__cell">@Model.Establishment.CurrentYear.Grade.DisplayText()</td>
                            <td class="govuk-table__cell">@Model.Establishment.CurrentYear.Points.DisplayText()</td>
                        </tr>
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@laName</th>
                            <td class="govuk-table__cell">@Model.LocalAuthority.CurrentYear.Grade.DisplayText()</td>
                            <td class="govuk-table__cell">@Model.LocalAuthority.CurrentYear.Points.DisplayText()</td>
                        </tr>
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">England average</th>
                            <td class="govuk-table__cell">@Model.England.CurrentYear.Grade.DisplayText()</td>
                            <td class="govuk-table__cell">@Model.England.CurrentYear.Points.DisplayText()</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div id="average-result-data-over-time-table-container" data-view-panel="@DataViewToggleHelper.OverTimeView" hidden="@(!showAverageResultOverTime)">

                <a id="average-result-show-current-data-btn"
                   href="@DataViewToggleHelper.ViewUrl(Context.Request, averageResultIdPrefix, overTime: false)"
                   role="button"
                   draggable="false"
                   class="govuk-button govuk-button--secondary govuk-!-margin-top-3 govuk-!-margin-bottom-0"
                   data-module="govuk-button"
                   data-show-view="@DataViewToggleHelper.CurrentView">Show current data</a>

                <table id="average-result-data-overtime-table" class="govuk-table">
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header"></th>
                            <th scope="col" class="govuk-table__header">@Model.AcademicYears.TwoYearsAgo</th>
                            <th scope="col" class="govuk-table__header">@Model.AcademicYears.PreviousYear</th>
                            <th scope="col" class="govuk-table__header">@Model.AcademicYears.CurrentYear</th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">Number of students</th>
                            <td class="govuk-table__cell">@Model.NumberOfStudents.TwoYearsAgo!.DisplayText()</td>
                            <td class="govuk-table__cell">@Model.NumberOfStudents.PreviousYear!.DisplayText()</td>
                            <td class="govuk-table__cell">@Model.NumberOfStudents.CurrentYear.DisplayText()</td>
                        </tr>
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">School or college grade</th>
                            <td class="govuk-table__cell">
                                @Model.Establishment.TwoYearsAgo!.Grade.DisplayText()
                                <div class="govuk-body-s">
                                    (@Model.Establishment.TwoYearsAgo!.Points.DisplayPoints())
                                </div>
                            </td>
                            <td class="govuk-table__cell">
                                @Model.Establishment.PreviousYear!.Grade.DisplayText()
                                <div class="govuk-body-s">
                                    (@Model.Establishment.PreviousYear!.Points.DisplayPoints())
                                </div>
                            </td>
                            <td class="govuk-table__cell">
                                @Model.Establishment.CurrentYear.Grade.DisplayText()
                                <div class="govuk-body-s">
                                    (@Model.Establishment.CurrentYear.Points.DisplayPoints())
                                </div>
                            </td>
                        </tr>
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@laName grade</th>
                            <td class="govuk-table__cell">
                                @Model.LocalAuthority.TwoYearsAgo!.Grade.DisplayText()
                                <div class="govuk-body-s">
                                    (@Model.LocalAuthority.TwoYearsAgo!.Points.DisplayPoints())
                                </div>
                            </td>
                            <td class="govuk-table__cell">
                                @Model.LocalAuthority.PreviousYear!.Grade.DisplayText()
                                <div class="govuk-body-s">
                                    (@Model.LocalAuthority.PreviousYear!.Points.DisplayPoints())
                                </div>
                            </td>
                            <td class="govuk-table__cell">
                                @Model.LocalAuthority.CurrentYear.Grade.DisplayText()
                                <div class="govuk-body-s">
                                    (@Model.LocalAuthority.CurrentYear.Points.DisplayPoints())
                                </div>
                            </td>
                        </tr>
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">England average grade</th>
                            <td class="govuk-table__cell">
                                @Model.England.TwoYearsAgo!.Grade.DisplayText()
                                <div class="govuk-body-s">
                                    (@Model.England.TwoYearsAgo!.Points.DisplayPoints())
                                </div>
                            </td>
                            <td class="govuk-table__cell">
                                @Model.England.PreviousYear!.Grade.DisplayText()
                                <div class="govuk-body-s">
                                    (@Model.England.PreviousYear!.Points.DisplayPoints())
                                </div>
                            </td>
                            <td class="govuk-table__cell">
                                @Model.England.CurrentYear.Grade.DisplayText()
                                <div class="govuk-body-s">
                                    (@Model.England.CurrentYear.Points.DisplayPoints())
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="data-container">
        <table id="average-result-current-year-table" class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header"></th>
                    <th scope="col" class="govuk-table__header">Grade</th>
                    <th scope="col" class="govuk-table__header">Points</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">School or college</th>
                    <td class="govuk-table__cell">@Model.Establishment.CurrentYear.Grade.DisplayText()</td>
                    <td class="govuk-table__cell">@Model.Establishment.CurrentYear.Points.DisplayText()</td>
                </tr>
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">@laName</th>
                    <td class="govuk-table__cell">@Model.LocalAuthority.CurrentYear.Grade.DisplayText()</td>
                    <td class="govuk-table__cell">@Model.LocalAuthority.CurrentYear.Points.DisplayText()</td>
                </tr>
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">England average</th>
                    <td class="govuk-table__cell">@Model.England.CurrentYear.Grade.DisplayText()</td>
                    <td class="govuk-table__cell">@Model.England.CurrentYear.Points.DisplayText()</td>
                </tr>
            </tbody>
        </table>
    </div>
}

@using SAPPub.Core.Enums.KS5Qualifications
@model SAPPub.Web.Areas.Profiles.ViewModels.KS5.AdditionalDataViewModel

@if (Model is null)
{
    return;
}

@{
    var laName = ViewData["LAName"];
}

<govuk-details id="additional-data-details">
    <govuk-details-summary>
        Additional data
    </govuk-details-summary>
    <govuk-details-text>
        <p id="no-of-students-included-in-measure-info" class="govuk-tag govuk-tag--full-width govuk-tag--grey govuk-!-margin-bottom-4">
            Number of students included in these measures: @Model.TotalNoOfStudentsIncludedInThisMeasure.DisplayText()
        </p>

        <h3 class="govuk-heading-m">Student’s best 3 A-levels</h3>

        <p class="govuk-body">
            The student’s 'best 3 A levels' score is calculated by:
        </p>

        <ol class="govuk-list govuk-list--number">
            <li>Adding together the points from a student’s best 3 A levels.</li>
            <li>Dividing that total by 3.</li>
            <li>Calculating the average across all eligible students at the school or college.</li>
        </ol>

        <p class="govuk-body">
            We also show this as a grade.
        </p>

        <p class="govuk-body">
            Compare this school or college with state-funded local and national averages.
        </p>

        <table id="additional-data-current-year-table" class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header"></th>
                    <th scope="col" class="govuk-table__header">Grade</th>
                    <th scope="col" class="govuk-table__header">Points</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">School or college</th>
                    <td class="govuk-table__cell">@Model.EstablishmentGrade.DisplayText()</td>
                    <td class="govuk-table__cell">@Model.EstablishmentPoints.DisplayText()</td>
                </tr>
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">@laName</th>
                    <td class="govuk-table__cell">@Model.LocalAuthorityGrade.DisplayText()</td>
                    <td class="govuk-table__cell">@Model.LocalAuthorityPoints.DisplayText()</td>
                </tr>
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">England average</th>
                    <td class="govuk-table__cell">@Model.EnglandGrade.DisplayText()</td>
                    <td class="govuk-table__cell">@Model.EnglandPoints.DisplayText()</td>
                </tr>
            </tbody>
        </table>

    </govuk-details-text>
</govuk-details>
@using SAPPub.Web.Constants
@using SAPPub.Web.ViewComponents.SchoolProfilePagination
@using SAPPub.Web.ViewComponents.VerticalNavigation
@model SAPPub.Web.Areas.Profiles.ViewModels.KS5.EnglishMathsQualificationsViewModel


@{
    ViewData["Header"] = PageTitleConstants.KS5SchoolPageTitles.Performance;
    ViewData["SubHeader"] = $"{PageTitleConstants.KS5SchoolPageTitles.PhaseTitle} - {PageTitleConstants.KS5SchoolPageTitles.EnglishAndMaths}";
    ViewData["Title"] = $"{Model.SchoolName} - {ViewData["SubHeader"]}";
}

<div class="govuk-grid-row">
    @await Component.InvokeAsync("VerticalNavigation",
    new VerticalNavigationModel
    {
        URN = Model.URN,
        SchoolName = Model.SchoolName,
        ActivePage = RouteConstants.KS5AcademicPerformanceEnglishMaths,
        IsKS2 = Model.IsKS2,
        IsKS4 = Model.IsKS4,
        IsKS5 = Model.IsKS5
    })

    <div class="govuk-grid-column-three-quarters">
        <h2 class="govuk-heading-xl">@ViewData["Header"]</h2>
        <p class="govuk-body">
            Choose the type of qualifications you want to see.
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>Level 2 qualifications include GCSEs, BTEC Firsts and other level 2 qualifications</li>
            <li>Level 3 qualifications include A levels, Tech levels, BTECs and other level 3 qualifications</li>
        </ul>

        <nav id="sub-navigation-academic-performance" class="moj-sub-navigation" aria-label="Sub navigation">
            <ul class="moj-sub-navigation__list">
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.KS5AcademicPerformanceLevel3" asp-all-route-data="@Model.RouteAttributes">@PageTitleConstants.KS5SchoolPageTitles.Level3Qualifications</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.KS5AcademicPerformanceLevel2" asp-all-route-data="@Model.RouteAttributes">@PageTitleConstants.KS5SchoolPageTitles.Level2Qualifications</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" aria-current="page" asp-route="@RouteConstants.KS5AcademicPerformanceEnglishMaths" asp-all-route-data="@Model.RouteAttributes">@PageTitleConstants.KS5SchoolPageTitles.EnglishAndMaths</a>
                </li>
                <li class="moj-sub-navigation__item">
                    <a class="moj-sub-navigation__link" asp-route="@RouteConstants.KS5AcademicPerformanceSubjectsEntered" asp-all-route-data="@Model.RouteAttributes">@PageTitleConstants.KS5SchoolPageTitles.SubjectsEntered</a>
                </li>
            </ul>
        </nav>

        <h2>English and maths</h2>

        <p class="govuk-body">
            These scores show how much progress students made in English and maths at level 2 and below between the end of key stage 4 and the end of 16 to 19 study.
        </p>

        <p class="govuk-body">
            Scores are based on results from approved qualifications, such as GCSEs, and are calculated using the highest grade a student achieves with the school or college.
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>A positive score means students, on average, improved their grades while studying with this school or college.</li>
            <li>A negative score means students, on average, got lower grades or were not entered into an exam for an approved English or maths qualification while studying with this school or college.</li>
        </ul>

        <p>
            This measure includes students who did not get a grade 4 or above in GCSE (or equivalent) by the end of key stage 4 in that subject.
            Read the <a id="tech-guidance-link" class="govuk-link" rel="noreferrer noopener" target="_blank" href="https://www.gov.uk/government/publications/16-to-19-accountability-headline-measures-technical-guide">
                16 to 19 accountability technical guide <span class="govuk-visually-hidden">(opens in a new tab)</span>
            </a>
        </p>

        <p>
            Compare this school or college with state funded local and national averages.
        </p>

        <div class="govuk-summary-card">
            <div class="govuk-summary-card__content">

                <table class="govuk-table govuk-!-margin-top-5" id="english-maths-scores-and-progress">
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header"></th>
                            <th scope="col" class="govuk-table__header">Number of students</th>
                            <th scope="col" class="govuk-table__header">School or college</th>
                            <th scope="col" class="govuk-table__header">@Model.LAName average</th>
                            <th scope="col" class="govuk-table__header">England average</th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">Average English progress</th>
                            <td class="govuk-table__cell">@Model.AverageEnglishProgress.NumberOfStudents.DisplayNumber(format: "N0")</td>
                            <td class="govuk-table__cell">@Model.AverageEnglishProgress.SchoolOrCollege.DisplayNumber()</td>
                            <td class="govuk-table__cell">@Model.AverageEnglishProgress.LaAverage.DisplayNumber()</td>
                            <td class="govuk-table__cell">@Model.AverageEnglishProgress.EnglandAverage.DisplayNumber()</td>
                        </tr>

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">Entered for English qualification</th>
                            <td class="govuk-table__cell"></td>
                            <td class="govuk-table__cell">@Model.EnteredForEnglishQualification.SchoolOrCollege.DisplayPercentage()</td>
                            <td class="govuk-table__cell">@Model.EnteredForEnglishQualification.LaAverage.DisplayPercentage()</td>
                            <td class="govuk-table__cell">@Model.EnteredForEnglishQualification.EnglandAverage.DisplayPercentage()</td>
                        </tr>

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">Average maths progress</th>
                            <td class="govuk-table__cell">@Model.AverageMathsProgress.NumberOfStudents.DisplayNumber(format: "N0")</td>
                            <td class="govuk-table__cell">@Model.AverageMathsProgress.SchoolOrCollege.DisplayNumber()</td>
                            <td class="govuk-table__cell">@Model.AverageMathsProgress.LaAverage.DisplayNumber()</td>
                            <td class="govuk-table__cell">@Model.AverageMathsProgress.EnglandAverage.DisplayNumber()</td>
                        </tr>

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">Entered for maths qualification</th>
                            <td class="govuk-table__cell"></td>
                            <td class="govuk-table__cell">@Model.EnteredForMathsQualification.SchoolOrCollege.DisplayPercentage()</td>
                            <td class="govuk-table__cell">@Model.EnteredForMathsQualification.LaAverage.DisplayPercentage()</td>
                            <td class="govuk-table__cell">@Model.EnteredForMathsQualification.EnglandAverage.DisplayPercentage()</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>


        <govuk-accordion id="disadvantaged-section" heading-level="3">
            <govuk-accordion-item expanded="false">
                <govuk-accordion-item-heading>Disadvantaged students</govuk-accordion-item-heading>
                <govuk-accordion-item-content>
                    <p class="govuk-body">
                        Disadvantaged students are those who attract pupil premium funding at the end of key stage 4.
                    </p>
                    <p class="govuk-body">
                        This includes students who:
                        <ul class="govuk-list govuk-list--bullet">
                            <li>have been eligible for free school meals at any time in the last 6 years</li>
                            <li>are, or have been, in the care of a local authority (including those adopted from care)</li>
                        </ul>
                    </p>
                    <p class="govuk-body">
                        You can compare their results with non‑disadvantaged students locally and across England.
                    </p>

                    <div class="data-container">
                        <table id="english-and-maths-disadvantaged-table" class="govuk-table">
                            <thead class="govuk-table__head">
                                <tr class="govuk-table__row">
                                    <th scope="col" class="govuk-table__header"></th>
                                    <th scope="col" class="govuk-table__header">School or college</th>
                                    <th scope="col" class="govuk-table__header">@Model.LAName average</th>
                                    <th scope="col" class="govuk-table__header">England average</th>
                                </tr>
                            </thead>
                            <tbody class="govuk-table__body">
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">Number of students for English</th>
                                    <td class="govuk-table__cell">@Model.NumberOfDisadvantagedStudentsEnglish.SchoolOrCollege.DisplayNumber()</td>
                                    <td class="govuk-table__cell">@Model.NumberOfDisadvantagedStudentsEnglish.LocalAuthority.DisplayNumber(format: "N0")</td>
                                    <td class="govuk-table__cell">@Model.NumberOfDisadvantagedStudentsEnglish.England.DisplayNumber(format: "N0")</td>
                                </tr>
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">Progress in English</th>
                                    <td class="govuk-table__cell">@Model.ProgressOfDisadvantagedStudentsEnglish.SchoolOrCollege.DisplayNumber()</td>
                                    <td class="govuk-table__cell">@Model.ProgressOfDisadvantagedStudentsEnglish.LocalAuthority.DisplayNumber()</td>
                                    <td class="govuk-table__cell">@Model.ProgressOfDisadvantagedStudentsEnglish.England.DisplayNumber()</td>
                                </tr>
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">Number of students for maths</th>
                                    <td class="govuk-table__cell">@Model.NumberOfDisadvantagedStudentsMaths.SchoolOrCollege.DisplayNumber()</td>
                                    <td class="govuk-table__cell">@Model.NumberOfDisadvantagedStudentsMaths.LocalAuthority.DisplayNumber(format: "N0")</td>
                                    <td class="govuk-table__cell">@Model.NumberOfDisadvantagedStudentsMaths.England.DisplayNumber(format: "N0")</td>
                                </tr>
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">Progress in maths</th>
                                    <td class="govuk-table__cell">@Model.ProgressOfDisadvantagedStudentsMaths.SchoolOrCollege.DisplayNumber()</td>
                                    <td class="govuk-table__cell">@Model.ProgressOfDisadvantagedStudentsMaths.LocalAuthority.DisplayNumber()</td>
                                    <td class="govuk-table__cell">@Model.ProgressOfDisadvantagedStudentsMaths.England.DisplayNumber()</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>


                    <govuk-details id="eng-maths-nondisadvantaged-details">
                        <govuk-details-summary>
                            Compare the Local council and England scores to non-disadvantaged students
                        </govuk-details-summary>
                        <govuk-details-text>
                            <h3 class="govuk-heading-m">Non-disadvantaged students</h3>

                            <div class="data-container">
                                <table id="english-and-maths-nondisadvantaged-table" class="govuk-table">
                                    <thead class="govuk-table__head">
                                        <tr class="govuk-table__row">
                                            <th scope="col" class="govuk-table__header"></th>
                                            <th scope="col" class="govuk-table__header">@Model.LAName average</th>
                                            <th scope="col" class="govuk-table__header">England average</th>
                                        </tr>
                                    </thead>
                                    <tbody class="govuk-table__body">
                                        <tr class="govuk-table__row">
                                            <th scope="row" class="govuk-table__header">Number of students for English</th>
                                            <td class="govuk-table__cell">@Model.NumberOfNonDisadvantagedStudentsEnglish.LocalAuthority.DisplayNumber(format: "N0")</td>
                                            <td class="govuk-table__cell">@Model.NumberOfNonDisadvantagedStudentsEnglish.England.DisplayNumber(format: "N0")</td>
                                        </tr>
                                        <tr class="govuk-table__row">
                                            <th scope="row" class="govuk-table__header">Progress in English</th>
                                            <td class="govuk-table__cell">@Model.ProgressOfNonDisadvantagedStudentsEnglish.LocalAuthority.DisplayNumber()</td>
                                            <td class="govuk-table__cell">@Model.ProgressOfNonDisadvantagedStudentsEnglish.England.DisplayNumber()</td>
                                        </tr>
                                        <tr class="govuk-table__row">
                                            <th scope="row" class="govuk-table__header">Number of students for maths</th>
                                            <td class="govuk-table__cell">@Model.NumberOfNonDisadvantagedStudentsMaths.LocalAuthority.DisplayNumber(format: "N0")</td>
                                            <td class="govuk-table__cell">@Model.NumberOfNonDisadvantagedStudentsMaths.England.DisplayNumber(format: "N0")</td>
                                        </tr>
                                        <tr class="govuk-table__row">
                                            <th scope="row" class="govuk-table__header">Progress in maths</th>
                                            <td class="govuk-table__cell">@Model.ProgressOfNonDisadvantagedStudentsMaths.LocalAuthority.DisplayNumber()</td>
                                            <td class="govuk-table__cell">@Model.ProgressOfNonDisadvantagedStudentsMaths.England.DisplayNumber()</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </govuk-details-text>
                    </govuk-details>

                </govuk-accordion-item-content>
            </govuk-accordion-item>
        </govuk-accordion>

    @await Component.InvokeAsync("SchoolProfilePagination", SchoolProfilePaginationModel.From(Model, RouteConstants.KS5AcademicPerformanceEnglishMaths))

    </div>
</div>

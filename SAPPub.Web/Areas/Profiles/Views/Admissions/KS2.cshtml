@model AdmissionsViewModel;
@using Microsoft.FeatureManagement
@using SAPPub.Web.Areas.Profiles.ViewModels.KS2
@using SAPPub.Web.Constants
@using SAPPub.Web.ViewComponents.VerticalNavigation

@{
    ViewData["Header"] = "Admissions";
    ViewData["SubHeader"] = PageTitleConstants.PrimarySchoolPageTitles.Admissions;
    ViewData["Title"] = $"{Model.SchoolName} - {ViewData["SubHeader"]}";
}

<div class="govuk-grid-row">
    @await Component.InvokeAsync("VerticalNavigation",
    new VerticalNavigationModel
    {
        URN = Model.URN,
        SchoolName = Model.SchoolName,
        ActivePage = RouteConstants.PrimaryAdmissions,
        IsKS2 = Model.IsKS2,
        IsKS4 = Model.IsKS4,
        IsKS5 = Model.IsKS5
    })

    <div class="govuk-grid-column-three-quarters">
        <span id="school-name-caption" class="govuk-caption-xl">@Model.SchoolName</span>
        <h1 class="govuk-heading-xl">@ViewData["Header"]</h1>
        @if (Model.IsKS4 == true)
        {
            <nav id="sub-navigation-academic-performance" class="moj-sub-navigation" aria-label="Sub navigation">
                <ul class="moj-sub-navigation__list">
                    <li class="moj-sub-navigation__item">
                        <a class="moj-sub-navigation__link" aria-current="page" asp-route="@RouteConstants.PrimaryAdmissions" asp-all-route-data="@Model.RouteAttributes">@PageTitleConstants.PrimarySchoolPageTitles.Admissions</a>
                    </li>
                    <li class="moj-sub-navigation__item">
                        <a class="moj-sub-navigation__link" asp-route="@RouteConstants.SecondaryAdmissions" asp-all-route-data="@Model.RouteAttributes">@PageTitleConstants.SecondarySchoolPageTitles.Admissions</a>
                    </li>
                </ul>
            </nav>
        }
        <h2 class="govuk-heading-l">Primary admissions</h2>

        <govuk-pagination id="admissions-pagination">
            <govuk-pagination-previous asp-route="@RouteConstants.AboutTheSchool" asp-all-route-data="@Model.RouteAttributes">About the school</govuk-pagination-previous>
            @if(Model.IsKS4)
            {
                <govuk-pagination-next asp-route="@RouteConstants.SecondaryAdmissions" asp-all-route-data="@Model.RouteAttributes">Secondary admissions</govuk-pagination-next>
            }
            else
            {
                <govuk-pagination-next asp-route="@RouteConstants.PrimaryCurriculum" asp-all-route-data="@Model.RouteAttributes">Primary curriculum</govuk-pagination-next>
            }
        </govuk-pagination>
    </div>
</div>
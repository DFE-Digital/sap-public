@model AdmissionsViewModel
@using SAPPub.Web.Areas.Profiles.ViewModels.Admissions
<div class="govuk-summary-card" data-testid="independent-school-summary">
    <div class="govuk-summary-card__title-wrapper">
        <h3 class="govuk-summary-card__title">Admissions policies</h3>
    </div>
    <div class="govuk-summary-card__content">
        <p class="govuk-body">
            To apply for a place at a private school, also known as independent schools, contact the school directly.
        </p>
        <govuk-summary-list>
            <govuk-summary-list-row>
                <govuk-summary-list-row-key>
                    Admissions policies
                </govuk-summary-list-row-key>
                <govuk-summary-list-row-value>
                    @if (Model.IsSchoolClosed)
                    {
                        <span data-testid="cannot-apply-info">You cannot apply for a place at this school because it is closed.</span>
                    }
                    else if (Model.SchoolWebsite.IsAvailable)
                    {
                        <a data-testid="school-website-link"
                           class="govuk-link"
                           href="@Model.SchoolWebsite.DisplayText(UrlHelper.EnsureHttpsUrl)"
                           target="_blank"
                           rel="noopener noreferrer">
                            Visit the school's website for more information on admissions policies
                            <span class="govuk-visually-hidden">(opens in a new tab)</span>
                        </a>
                    }
                    else
                    {
                        <span data-testid="contact-school-info">Contact the school for more information</span>
                    }
                </govuk-summary-list-row-value>
            </govuk-summary-list-row>
        </govuk-summary-list>
    </div>
</div>
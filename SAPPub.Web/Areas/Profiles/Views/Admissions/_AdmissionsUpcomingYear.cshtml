@using SAPPub.Web.Areas.Profiles.ViewModels.Admissions
@model AdmissionsViewModel

<div class="govuk-summary-card" data-testid="starting-secondary-school-summary">
    <div class="govuk-summary-card__title-wrapper">
        <h3 class="govuk-summary-card__title">
            Starting secondary school in September @Model.UpcomingAcadmeicYear
        </h3>
    </div>
    <div class="govuk-summary-card__content">
        <p class="govuk-body">
            Children in year @Model.YearChild, should start secondary school in September @Model.UpcomingAcadmeicYear.
        </p>
        <p class="govuk-body">
            You must apply for your child to get a place at secondary school.
            The application window for starting secondary school in September @Model.UpcomingAcadmeicYear will open in summer @Model.CurrentAcademicYear.
            You'll need to apply for a place by 31 October @Model.CurrentAcademicYear.
            You can do this by following your local council's secondary school application process.
        </p>
        <govuk-summary-list>
            <govuk-summary-list-row>
                <govuk-summary-list-row-key>
                    Admissions policies
                </govuk-summary-list-row-key>
                <govuk-summary-list-row-value>
                    @if (Model.IsSchoolClosed)
                    {
                        <span data-testId="cannot-apply-info">You cannot apply for a place at this school because it is closed.</span>
                    }
                    else if (Model.SchoolWebsite.IsAvailable)
                    {
                        <a data-testid="school-website-link"
                           class="govuk-link govuk-link--no-visited-state"
                           href="@Model.SchoolWebsite.DisplayText(UrlHelper.EnsureHttpsUrl)"
                           target="_blank"
                           rel="noopener noreferrer">
                            View the school website to view the admissions
                            policies
                            <span class="govuk-visually-hidden">(opens in a new tab)</span>
                        </a>
                    }
                    else
                    {
                        <span data-testId="contact-school-info">Contact the school for more information</span>
                    }
                </govuk-summary-list-row-value>
            </govuk-summary-list-row>
            <govuk-summary-list-row>
                <govuk-summary-list-row-key>
                    Applying for a school place
                </govuk-summary-list-row-key>
                <govuk-summary-list-row-value>
                    <a data-testid="la-website-link"
                       class="govuk-link govuk-link--no-visited-state"
                       href="@UrlHelper.EnsureHttpsUrl(Model.LASchoolAdmissionsLinkUrl)"
                       target="_blank"
                       rel="noopener noreferrer">
                        Visit the local council's website for more information on
                        applying for a school place
                        <span class="govuk-visually-hidden">(opens in a new tab)</span>
                    </a>
                </govuk-summary-list-row-value>
            </govuk-summary-list-row>
        </govuk-summary-list>
    </div>
</div>

<div data-testid="starting-secondary-school-next">
    <h3 class="govuk-heading-m">Starting secondary school in September @Model.YearAfterUpcomingAcademicYear</h3>
    <p class="govuk-body">
        Admissions for starting secondary school in September @Model.YearAfterUpcomingAcademicYear will open in summer @Model.UpcomingAcadmeicYear.
    </p>
    <p class="govuk-body">
        Children in year @(Model.YearChild - 1), should start secondary school in September @Model.YearAfterUpcomingAcademicYear.
        You must apply for your child to get a place at secondary school.
        The application window for starting secondary school in September @Model.YearAfterUpcomingAcademicYear will open in summer @Model.UpcomingAcadmeicYear.
        You'll need to apply for a place by 31 October @Model.UpcomingAcadmeicYear. You can do this by following your local council's secondary school application process.
    </p>
</div>


<div data-testid="starting-secondary-school-afternext">
    <h3 class="govuk-heading-m">Starting secondary school in September @Model.TwoYearsAfterUpcomingAcademicYear</h3>
    <p class="govuk-body">
        Children in year @(Model.YearChild - 2), should start secondary school in September @Model.TwoYearsAfterUpcomingAcademicYear.
        The application window for starting secondary school in September @Model.TwoYearsAfterUpcomingAcademicYear will open in summer @Model.YearAfterUpcomingAcademicYear.
        You'll need to apply for a place by 31 October @Model.YearAfterUpcomingAcademicYear.
    </p>
    <p class="govuk-body">
        Schools must publish their policies for starting school in September @Model.TwoYearsAfterUpcomingAcademicYear by March @Model.YearAfterUpcomingAcademicYear.
    </p>
</div>